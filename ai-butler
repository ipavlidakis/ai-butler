def settings(missing_ok=True):
    try:
        cfg = read_local_json(CONFIG)
    except FileNotFoundError:
        if not missing_ok:
            raise
        return {"pools": ["tmp"], "settlement_grace_seconds": DEFAULT_GRACE * 60,
                "interval_minutes": DEFAULT_INTERVAL, "log_retention_days": DEFAULT_RETENTION,
                "evidence_retention_days": DEFAULT_EVIDENCE_RETENTION}
    pools = cfg["pools"]
    grace = cfg["settlement_grace_seconds"]
    interval = cfg["interval_minutes"]
    retention = cfg.setdefault("log_retention_days", DEFAULT_RETENTION)
    evidence = cfg.setdefault("evidence_retention_days", DEFAULT_EVIDENCE_RETENTION)
    report_paths = cfg.get("report_paths", [])
    if (type(evidence) is not int or not 0 <= evidence <= 36500
            or not isinstance(report_paths, list)
            or any(not isinstance(p, str) or not Path(p).expanduser().is_absolute()
                   for p in report_paths)):
        raise ValueError("Invalid evidence retention or report paths in " + str(CONFIG))
    projects = cfg.get("project_cleanup", {})
    if (not isinstance(pools, list)
            or any(not isinstance(p, str) or not POOL_NAME.fullmatch(p) for p in pools)
            or len(set(pools)) != len(pools) or type(grace) is not int
            or not 60 <= grace <= MAX_MINUTES * 60 or grace % 60
            or type(interval) is not int or not 1 <= interval <= MAX_MINUTES
            or type(retention) is not int or not 1 <= retention <= 36500
            or not isinstance(projects, dict)
            or any(not isinstance(k, str) or not PROJECT_NAME.fullmatch(k)
                   or not isinstance(v, list) or any(not isinstance(p, str) for p in v)
                   for k, v in projects.items())):
        raise ValueError("Invalid pool, project or timing settings in " + str(CONFIG))
    return cfg


def configure_storage(cfg):
    global ROOT, REPORT, AUDIT_DIR
    root = Path(cfg.get("scratch_root", str(ROOT))).expanduser()
    state = Path(cfg.get("state_directory", str(REPORT.parent))).expanduser()
    if (not root.is_absolute() or not state.is_absolute()
            or root.resolve() != root or state.resolve() != state
            or HOME not in root.parents or HOME not in state.parents
            or review.overlaps(root, state)):
        raise ValueError("Scratch and state must be separate canonical directories under your home")
    ROOT, REPORT, AUDIT_DIR = root, state / "latest.json", state / "audit"


def directory(path):
    if not review.directory(path) or path.is_symlink() or path.stat().st_uid != os.getuid():
        raise ValueError(f"Not an owned, canonical directory: {path}")
    return path


def identity(path):
    info = directory(path).stat()
    return [info.st_dev, info.st_ino]


def write_file(path, data):
    with tempfile.NamedTemporaryFile(dir=directory(path.parent), delete=False) as stream:
        try:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            stream.close()
            os.replace(stream.name, path)
        finally:
            Path(stream.name).unlink(missing_ok=True)


def write_json(path, data):
    write_file(path, (json.dumps(data, indent=2) + "\n").encode())


def ensure_directory(path):
    if not path.exists():
        ensure_directory(path.parent)
        path.mkdir(mode=0o700, exist_ok=True)
    return directory(path)


def read_local_json(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError(f"Not an owned metadata file: {path}")
        return json.load(stream)


def audit(event, sweep_id, **fields):
    now = datetime.now(timezone.utc)
    path = ensure_directory(AUDIT_DIR) / f"{now.date().isoformat()}.jsonl"
    flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or info.st_mode & 0o077):
            raise ValueError("The audit log must be a private, owned regular file")
        stream.write(json.dumps({"at": now.isoformat(),
                                 "event": event, "sweep_id": sweep_id, **fields}) + "\n")
        stream.flush()
        os.fsync(stream.fileno())


def expire_audit(days):
    cutoff = datetime.now(timezone.utc).date() - timedelta(days=days - 1)
    for path in directory(AUDIT_DIR).iterdir():
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}\.jsonl", path.name):
            continue
        try:
            day = date.fromisoformat(path.stem)
        except ValueError:
            continue
        info = path.lstat()
        if (day < cutoff and stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid()
                and info.st_nlink == 1 and not info.st_mode & 0o077):
            path.unlink()


@contextmanager
def lock_file(path, create=0, nonblocking=True, shared=False):
    flags = os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK
    directory(path.parent)
    fd = os.open(path, flags | create, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise ValueError("Invalid lock file")
        fcntl.flock(fd, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
                    | (fcntl.LOCK_NB if nonblocking else 0))
        yield fd
    finally:
        os.close(fd)


def lock(job, create=False):
    return lock_file(job / "lock", os.O_CREAT | os.O_EXCL if create else 0)


@contextmanager
def config_lock(shared=False):
    ensure_directory(CONFIG.parent)
    with lock_file(CONFIG.with_name("lock"), os.O_CREAT, nonblocking=False, shared=shared):
        yield


def workspace_lock(workspace, nonblocking=False):
    return lock_file(workspace / ".build-cleanup.lock", os.O_CREAT, nonblocking=nonblocking)


def thread_checkout(snapshot, thread, allow_missing=False):
    matches = [path for path, rows in snapshot.threads.items()
               if any(tid == thread for tid, _ in rows)]
    if (snapshot.has_unmapped_legacy_threads or len(matches) != 1
            or not any(root in matches[0].parents for root in (WORKTREES, T3_SCRATCH))):
        raise ValueError("Thread must map to an exact managed T3 worktree or scratch checkout")
    checkout = matches[0]
    if not allow_missing or checkout.exists():
        directory(checkout)
    if any(review.overlaps(checkout, p) and p != T3_SCRATCH for p in snapshot.projects):
        raise ValueError("Thread overlaps a T3 project checkout")
    if any(review.overlaps(ROOT, path) for path in (*snapshot.projects, *snapshot.threads)):
        raise ValueError("A T3 checkout overlaps the disposable storage root")
    return checkout


def settled_threads(snapshot, checkout, grace):
    related = set()
    for path, rows in snapshot.threads.items():
        if review.overlaps(path, checkout):
            related.update(tid for tid, _ in rows)
    descendants = {}
    for tid, row in snapshot.thread_rows.items():
        parent = (row.get("lineage") or {}).get("parentThreadId")
        if parent is not None:
            descendants.setdefault(parent, []).append(tid)
    pending = list(related)
    while pending:
        for child in descendants.get(pending.pop(), ()):
            if child not in related:
                related.add(child)
                pending.append(child)
    for tid in related:
        row = snapshot.thread_rows[tid]
        settled = row["settledAt"]
        if (not settled or row.get("settledOverride") == "active" or row.get("pinnedAt")
                or row.get("snoozedUntil") or tid in snapshot.active):
            return "T3 owner or related thread is active or not settled"
        timestamp = datetime.fromisoformat(settled.replace("Z", "+00:00"))
        if timestamp.tzinfo is None or time.time() - timestamp.timestamp() < grace:
            return "T3 thread settled within the grace period"
    return None


def ready(job, owner, grace):
    if owner["job"] != job.name or owner["job_identity"] != identity(job):
        return "registration does not match this directory"
    data = directory(job / "data")
    if owner["data_identity"] != identity(data):
        return "scratch directory has been replaced"
    if len({path.stat().st_dev for path in (ROOT, job.parent, job, data)}) != 1:
        return "scratch is on another filesystem"
    if owner["finished_at"] is None or not owner["finished_at"] <= time.time() - grace:
        return "command has not finished or is still within the grace period"
    snapshot = review.load_t3(DB)
    checkout = thread_checkout(snapshot, owner["thread"], allow_missing=True)
    if (str(checkout) != owner["checkout"]
            or checkout.exists() and identity(checkout) != owner["checkout_identity"]):
        return "T3 checkout no longer matches the registration"
    return settled_threads(snapshot, checkout, grace)


def open_or_mounted(data, preserve_evidence=False):
    def fail(exc):
        raise exc
    device = data.stat().st_dev
    for base, dirs, files in os.walk(data, followlinks=False, onerror=fail):
        for name in dirs + files:
            if preserve_evidence and name.endswith((".xcresult", ".xcarchive", ".ipa")):
                return "build directory contains a test result, archive, or export"
            if (Path(base) / name).lstat().st_dev != device:
                return "scratch contains another filesystem"
    return open_under(data, OPEN_FILES)


OPEN_FILES = "open files or incomplete process check"


def within(path, root):
    return path == root or root in path.parents


def open_holders(path):
    """PIDs with files open under `path`, or None when the system-wide listing is incomplete."""
    opened = subprocess.run(["/usr/sbin/lsof", "-nP", "-F", "pn"], capture_output=True, timeout=60)
    if opened.returncode != 0 or opened.stderr:
        return None
    target = os.fsencode(os.path.realpath(path))
    pid, holders = None, set()
    for line in opened.stdout.splitlines():
        if line[:1] == b"p":
            pid = int(line[1:])
        elif line[:1] == b"n" and (line[1:] == target or line[1:].startswith(target + b"/")):
            holders.add(pid)
    return holders


def process_details(pid):
    """(parent pid, uid, command, cwd) of a live process, or None."""
    info = subprocess.run(["/bin/ps", "-o", "ppid=,uid=,command=", "-p", str(pid)],
                          capture_output=True, text=True, timeout=10)
    fields = info.stdout.strip().split(None, 2)
    if info.returncode != 0 or len(fields) < 3:
        return None
    found = subprocess.run(["/usr/sbin/lsof", "-a", "-nP", "-p", str(pid), "-d", "cwd", "-F", "n"],
                           capture_output=True, text=True, timeout=10)
    cwd = next((line[1:] for line in found.stdout.splitlines() if line.startswith("n")), None)
    return int(fields[0]), int(fields[1]), fields[2], cwd


def stop_orphans(path, roots, apply, sweep_id, evidence):
    """Stop orphaned processes left behind by a settled task that keep files under `path` open.

    A hung test helper or build daemon outlives its agent and is re-parented to launchd, which blocks
    cleanup forever. Every holder must be one of ours, orphaned, and running from or naming one of
    `roots`; otherwise nothing is stopped. Returns a reason to keep the path, or None once they exited.
    """
    holders = open_holders(path)
    if not holders or os.getpid() in holders:
        return OPEN_FILES
    roots = [Path(os.path.realpath(root)) for root in roots]
    found = []
    for pid in sorted(holders):
        details = process_details(pid)
        if details is None:
            return OPEN_FILES
        ppid, uid, command, cwd = details
        named = any(str(root) in command for root in roots)
        inside = cwd is not None and any(within(Path(os.path.realpath(cwd)), root) for root in roots)
        if ppid != 1 or uid != os.getuid() or not (named or inside):
            return OPEN_FILES
        found.append({"pid": pid, "command": command[:500], "cwd": cwd})
    if not apply:
        return f"held open by {len(found)} orphaned process(es) that the next sweep stops"
    audit("stop_orphans", sweep_id, **dict(evidence, processes=found))
    for process in found:
        try:
            os.kill(process["pid"], 15)
        except ProcessLookupError:
            pass
    deadline = time.time() + 10
    while time.time() < deadline:
        alive = []
        for process in found:
            try:
                os.kill(process["pid"], 0)
                alive.append(process)
            except ProcessLookupError:
                pass
        if not alive:
            return None
        time.sleep(0.5)
    return "orphaned processes did not exit after SIGTERM"


def open_under(path, reason):
    processes = subprocess.run(["/bin/ps", "-axww", "-o", "command="], capture_output=True, timeout=10)
    if processes.returncode or processes.stderr or not processes.stdout.strip():
        return "could not inspect process command lines"
    for spelling in {os.fsencode(path), os.fsencode(os.path.realpath(path))}:
        if re.search(re.escape(spelling) + rb"(?:[/\s\x22\x27]|$)", processes.stdout, re.MULTILINE):
            return "a running process names this path on its command line"
    # One system-wide listing stays fast; `lsof +D` walks the tree and timed out on a 45 GB cache.
    opened = subprocess.run(["/usr/sbin/lsof", "-nP", "-F", "n"], capture_output=True, timeout=60)
    if opened.returncode != 0 or opened.stderr:
        return reason
    target = os.fsencode(os.path.realpath(path))
    for line in opened.stdout.splitlines():
        name = line[1:]
        if line[:1] == b"n" and (name == target or name.startswith(target + b"/")):
            return reason
    return None


def build_workspaces(cfg):
    value = cfg.get("build_artifacts_root")
    if value is None:
        return None
    root = Path(value).expanduser()
    if (HOME not in root.parents or root.resolve() != root or root == WORKTREES
            or WORKTREES in root.parents or root in WORKTREES.parents):
        raise ValueError("Build artifact root must be canonical and separate from worktrees")
    managed = root / "workspaces"
    if any(review.overlaps(managed, path) for path in (ROOT, REPORT.parent, T3_SCRATCH)):
        raise ValueError("Build workspaces overlap scratch, state, or T3 storage")
    return managed


def build_checkout(workspace, owner):
    checkout = Path(owner["checkout"])
    if (WORKTREES not in checkout.parents or checkout.resolve() != checkout
            or len(checkout.relative_to(WORKTREES).parts) != 2
            or workspace.name != hashlib.sha256(str(checkout).encode()).hexdigest()[:16]):
        raise ValueError("Ownership does not match a canonical managed worktree")
    return checkout


def artifact_hook(options):
    payload = json.load(sys.stdin) if options.provider != "other" and not options.cwd else {}
    provider = options.provider
    if provider == "claude" and (payload.get("cursor_version") or os.getenv("CURSOR_VERSION")):
        provider = "cursor"
    roots = payload.get("workspace_roots") or payload.get("workspacePaths") or []
    cwd = Path(options.cwd or payload.get("cwd") or (roots[0] if roots else Path.cwd()))
    cwd = cwd.resolve(strict=True)
    if not cwd.is_dir():
        raise ValueError("Hook checkout must be a directory")
    checkout = next((p for p in (cwd, *cwd.parents) if (p / ".git").exists()), cwd)
    session = (options.session or payload.get("session_id")
               or payload.get("conversation_id") or payload.get("conversationId") or uuid.uuid4().hex)
    with ExitStack() as scope:
        managed = build_workspaces(settings(missing_ok=False))
        if managed is None:
            raise ValueError("Artifact hooks are not configured")
        name = re.sub(r"[^a-zA-Z0-9._-]+", "-", checkout.name).strip(".-")[:48] or "workspace"
        workspace = ensure_directory(managed / name / hashlib.sha256(str(checkout).encode()).hexdigest()[:16])
        scope.enter_context(workspace_lock(workspace))
        marker = workspace / "owner.json"
        if not marker.exists() and not marker.is_symlink():
            if any(path.name != ".build-cleanup.lock" for path in workspace.iterdir()):
                raise ValueError("Existing workspace has no ownership record")
            owner = {"checkout": str(checkout), "created_at": datetime.now(timezone.utc).isoformat(),
                     "retention": "protected-until-explicit-review"}
            if (WORKTREES in checkout.parents and len(checkout.relative_to(WORKTREES).parts) == 2):
                owner["build_cleanup"] = {"version": 1, "workspace_identity": identity(workspace),
                                          "checkout_identity": identity(checkout)}
            write_json(marker, owner)
        elif read_local_json(marker)["checkout"] != str(checkout):
            raise ValueError("Artifact workspace has a different owner")
        run_dir = ensure_directory(workspace / "runs" / (
            provider + "-" + hashlib.sha256(session.encode()).hexdigest()[:16]))
        run_owner = run_dir / "owner.json"
        if not run_owner.exists() and not run_owner.is_symlink():
            write_json(run_owner, {"checkout": str(checkout), "provider": provider, "session_id": session,
                                   "created_at": datetime.now(timezone.utc).isoformat(),
                                   "retention": "protected-until-explicit-review"})
        else:
            data = read_local_json(run_owner)
            if (data["checkout"], data["provider"], data["session_id"]) != (str(checkout), provider, session):
                raise ValueError("Artifact run has a different owner")
        env = {"AGENT_ARTIFACTS_ROOT": str(managed.parent), "AGENT_CHECKOUT": str(checkout),
               "AGENT_WORKSPACE_ARTIFACTS": str(workspace), "AGENT_RUN_DIR": str(run_dir)}
        for key, path in (("XCODE", workspace / "build/xcode"),
                          ("SWIFTPM", workspace / "build/swiftpm"),
                          ("LOG", run_dir / "logs"), ("RESULTS", run_dir / "results"),
                          ("SCREENSHOTS", run_dir / "screenshots"), ("TMP", run_dir / "tmp")):
            env[f"AGENT_{key}_DIR"] = str(ensure_directory(path))
        env_file = run_dir / "env.sh"
        content = "".join(f"export {key}={shlex.quote(value)}\n" for key, value in env.items())
        write_file(env_file, content.encode())
    context = (f"Source {shlex.quote(str(env_file))} before building. "
               "Use the assigned DerivedData or SwiftPM scratch path and keep evidence in the run directory.")
    if options.provider == "claude" and provider == "claude" and os.getenv("CLAUDE_ENV_FILE"):
        with open(os.environ["CLAUDE_ENV_FILE"], "a") as stream:
            stream.write("\n" + content)
    if options.provider == "cursor":
        output = {"env": env, "additional_context": context}
    elif provider in ("codex", "claude"):
        output = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}
    elif provider == "antigravity":
        # Antigravity hooks cannot set the agent's environment; the message tells it what to source.
        output = {"injectSteps": [{"systemMessage": {"systemMessage": context}}]}
    else:
        output = {"env_file": str(env_file), "env": env, "context": context}
    print(json.dumps(output))
    return 0


def antigravity_hook_files():
    """Antigravity reads ~/.gemini/config; T3 gives each Antigravity instance its own GEMINI_HOME."""
    homes = [HOME / ".gemini"] if (HOME / ".gemini").is_dir() else []
    if T3_ANTIGRAVITY_PROFILES.is_dir():
        homes += sorted(p for p in T3_ANTIGRAVITY_PROFILES.iterdir() if p.is_dir() and not p.is_symlink())
    return [home / "config/hooks.json" for home in homes]


def add_hook(hooks, command, legacy, path, flat, entry):
    """Add one command hook to an event list, or update an older command in place. True when changed."""
    matches = [hook for group in hooks
               for hook in ([group] if flat else group.get("hooks", []))
               if hook.get("command") in (command, *legacy)]
    if len(matches) > 1:
        raise ValueError(f"Multiple AI Butler hooks in {path}; keep just one before installing")
    if matches and matches[0]["command"] == command:
        return False
    if matches:
        matches[0]["command"] = command
    else:
        hooks.append(entry)
    return True


def hook_updates():
    changes = []
    for provider, relative in (("codex", ".codex/hooks.json"), ("claude", ".claude/settings.json"),
                               ("cursor", ".cursor/hooks.json")):
        path = HOME / relative
        if not path.parent.is_dir():
            continue
        try:
            data = read_local_json(path)
        except FileNotFoundError:
            data = {"version": 1} if provider == "cursor" else {}
        flat = provider == "cursor"
        events = data.setdefault("hooks", {})
        command = shlex.join([*SERVICE_COMMAND, "artifact-hook", provider])
        legacy = (shlex.join(["/usr/bin/python3", str(HOME / ".agents/hooks/artifact-storage.py"), provider]),)
        entry = ({"command": command, "timeout": 5} if flat
                 else {"hooks": [{"type": "command", "command": command, "timeout": 5}]})
        changed = add_hook(events.setdefault("sessionStart" if flat else "SessionStart", []),
                           command, legacy, path, flat, entry)
        if provider in ("codex", "claude"):
            guard = shlex.join([*SERVICE_COMMAND, "guard", provider])
            group = {"hooks": [{"type": "command", "command": guard, "timeout": 5}]}
            if provider == "claude":
                group = {"matcher": "Bash", **group}
            changed |= add_hook(events.setdefault("PreToolUse", []), guard, (), path, False, group)
        if changed:
            changes.append((path, data))
    for path in antigravity_hook_files():
        try:
            data = read_local_json(path)
        except FileNotFoundError:
            data = {}
        before = json.dumps(data, sort_keys=True)
        start = shlex.join([*SERVICE_COMMAND, "artifact-hook", "antigravity"])
        guard = shlex.join([*SERVICE_COMMAND, "guard", "antigravity"])
        data[HOOK_NAMES["artifacts"]] = {"SessionStart": [{"type": "command", "command": start, "timeout": 5}]}
        data[HOOK_NAMES["guard"]] = {"PreToolUse": [{"matcher": "run_command", "hooks": [
            {"type": "command", "command": guard, "timeout": 5}]}]}
        if json.dumps(data, sort_keys=True) != before:
            changes.append((path, data))
    return changes


def bare_xcodebuild(command):
    """True when a shell command runs xcodebuild on a workspace without -derivedDataPath."""
    text = command.replace("\\\n", " ")
    for match in XCODEBUILD_CALL.finditer(text):
        arguments = match.group(1).split()
        if "-derivedDataPath" in arguments or any(a.startswith("-derivedDataPath=") for a in arguments):
            continue
        if arguments and XCODEBUILD_INFO_FLAGS.intersection(arguments):
            continue
        return True
    return False


def guard(options):
    """PreToolUse hook: stop xcodebuild calls in T3 worktrees that would write the shared DerivedData."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return 0
    if options.provider == "antigravity":
        tool = payload.get("toolCall") or {}
        command = (tool.get("args") or {}).get("CommandLine")
    else:
        command = (payload.get("tool_input") or {}).get("command")
    if isinstance(command, list):
        command = shlex.join(str(part) for part in command)
    cwd = Path(payload.get("cwd") or Path.cwd())
    blocked = (isinstance(command, str) and worktree_of(Path(os.path.realpath(cwd))) is not None
               and bare_xcodebuild(command))
    if options.provider == "antigravity":
        # "ask" keeps Antigravity's own permission flow for every other command.
        print(json.dumps({"decision": "deny", "reason": GUARD_MESSAGE} if blocked else {"decision": "ask"}))
    elif blocked:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": GUARD_MESSAGE}}))
    return 0


def check_build(workspace, path, expected, owner, grace):
    if identity(path) != expected or path.stat().st_dev != workspace.stat().st_dev:
        return "build directory was replaced or is on another filesystem"
    if read_local_json(workspace / "owner.json") != owner:
        return "build ownership changed"
    checkout = build_checkout(workspace, owner)
    if checkout.exists() and identity(checkout) != owner["build_cleanup"]["checkout_identity"]:
        return "worktree has been replaced"
    for entry in path.iterdir():
        if entry.name not in {"xcode", "swiftpm", "native"} or not review.directory(entry):
            return "unrecognized output in the build directory"
    snapshot = review.load_t3(DB)
    if snapshot.has_unmapped_legacy_threads or not snapshot.threads.get(checkout):
        return "no complete T3 ownership for this worktree"
    if any(review.overlaps(checkout, p) for p in snapshot.projects):
        return "worktree overlaps a project checkout"
    if any(review.overlaps(workspace, p) for p in (*snapshot.projects, *snapshot.threads)):
        return "build storage overlaps a T3 checkout"
    for protected in (*snapshot.projects, *snapshot.threads):
        if protected == checkout or not protected.exists():
            continue
        for alias in (protected / ".build", protected / "DerivedData"):
            if alias.is_symlink() and review.overlaps(workspace / "build", alias.resolve()):
                return "another T3 checkout refers to this build directory"
    return settled_threads(snapshot, checkout, grace)


def restore_build(parked, build):
    rename = ctypes.CDLL(None, use_errno=True).renamex_np
    rename.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
    if rename(os.fsencode(parked), os.fsencode(build), 0x00000004) == 0:  # RENAME_EXCL
        return True
    code = ctypes.get_errno()
    if code == errno.EEXIST:
        return False
    raise OSError(code, os.strerror(code), str(parked), str(build))


def sweep_builds(cfg, apply, sweep_id, entries):
    managed = build_workspaces(cfg)
    if managed is None or not managed.exists():
        return
    directory(managed)
    for workspace in sorted(managed.glob("*/*")):
        build = workspace / "build"
        if not review.directory(workspace):
            continue
        for parked in sorted(workspace.glob(".retired-build-*")):
            entries.append({"kind": "build", "path": str(parked), "status": "staged",
                            "reason": "interrupted cleanup; preserved for manual review"})
        if not build.exists() and not build.is_symlink():
            continue
        entry = {"kind": "build", "path": str(build), "status": "keep"}
        entries.append(entry)
        try:
            inspect_build(cfg, apply, sweep_id, workspace, build, entry)
        except BlockingIOError:
            entry["reason"] = "artifact setup holds the workspace lock"
        except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                review.sqlite3.Error, subprocess.SubprocessError) as exc:
            entry["reason"] = str(exc)


def inspect_build(cfg, apply, sweep_id, workspace, build, entry):
    with ExitStack() as scope:
        directory(workspace)
        owner = read_local_json(workspace / "owner.json")
        marker = owner.get("build_cleanup")
        if not isinstance(marker, dict) or marker.get("version") != 1:
            entry["reason"] = "build output was not opted in at allocation"
            return
        if apply:
            # Only hold the workspace lock for the final rename and validation.
            # Preliminary inspection can be slow and does not change the workspace.
            guard = workspace / ".build-cleanup.lock"
            if not guard.is_file() or guard.is_symlink():
                raise ValueError("Missing artifact workspace lock")
        if marker["workspace_identity"] != identity(workspace):
            raise ValueError("build registration does not match its workspace")
        entry["checkout"] = owner["checkout"]
        expected = identity(build)
        grace = cfg["settlement_grace_seconds"]
        reason = check_build(workspace, build, expected, owner, grace)
        if not reason:
            reason = open_or_mounted(build, preserve_evidence=True)
            if reason == OPEN_FILES:
                reason = (stop_orphans(build, (build, Path(owner["checkout"])), apply, sweep_id,
                                       {"kind": "build", "path": str(build), "checkout": owner["checkout"]})
                          or open_or_mounted(build, preserve_evidence=True))
        if reason:
            entry["reason"] = reason
            return
        entry["allocated_kib"] = review.size_kib(build)
        if not apply:
            entry["status"] = "eligible"
            return
        if not sweep_id:
            raise ValueError("Deletion requires a sweep audit ID")
        parked = workspace / (".retired-build-" + uuid.uuid4().hex)
        evidence = {"kind": "build", "path": str(build), "checkout": entry["checkout"],
                    "staged_path": str(parked), "allocated_kib": entry["allocated_kib"],
                    "reason": "all T3 owners settled and no detected open files"}
        scope.enter_context(lock_file(guard))
        reason = check_build(workspace, build, expected, owner, grace)
        if reason:
            entry["reason"] = reason
            return
        audit("delete_intent", sweep_id, **evidence)
        reason = check_build(workspace, build, expected, owner, grace)
        if reason:
            entry["reason"] = reason
            audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
            return
        # shortcut: T3 has no cross-process startup lock; detach the old generation
        # so a resumed build can only recreate the original path, not write into it.
        build.rename(parked)
        entry["staged_path"] = str(parked)
        entry["status"] = "staged"
        try:
            reason = (open_or_mounted(parked, preserve_evidence=True)
                      or check_build(workspace, parked, expected, owner, grace)
                      or ("build was recreated" if build.exists() or build.is_symlink() else None))
        except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                review.sqlite3.Error, subprocess.SubprocessError) as exc:
            reason = str(exc)
        if reason:
            entry["reason"] = reason
            if restore_build(parked, build):
                entry["status"] = "keep"
                entry.pop("staged_path")
            audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
            return
        scope.close()
        try:
            shutil.rmtree(parked)
        except OSError as exc:
            entry["reason"] = str(exc)
            audit("delete_failed", sweep_id, **dict(evidence, reason=str(exc)))
            return
        entry["status"] = "deleted"
        audit("deleted", sweep_id, **evidence)


def project_pattern(cfg, value):
    """Split a stray-file pattern into a literal, canonical directory and a filename glob."""
    path = Path(value)
    parent, name = path.parent, path.name
    if (not path.is_absolute() or str(path) != value or not review.directory(parent)
            or any(c in str(parent) for c in "*?[]") or len(re.sub(r"[*?\[\]]", "", name)) < 4):
        raise ValueError(f"Pattern must be an existing canonical directory plus a filename glob "
                         f"with at least four literal characters: {value}")
    managed = build_workspaces(cfg)
    for protected in (WORKTREES, T3_SCRATCH, ROOT, REPORT.parent, *([managed] if managed else [])):
        if review.overlaps(parent, protected):
            raise ValueError(f"Pattern directory overlaps managed or T3 storage: {parent}")
    return parent, name


def file_owner(path, project):
    """Return the one worktree of `project` that the file names, plus the file's identity."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise ValueError("Not an owned regular file with a single link")
        head = stream.read(OWNER_SCAN_BYTES).decode("utf-8", "replace")
    names = set(re.findall(re.escape(str(WORKTREES / project)) + r"/([^/\s\"'`:;,)]+)", head))
    checkout = WORKTREES / project / names.pop() if len(names) == 1 else None
    return checkout, [info.st_dev, info.st_ino]


def check_project_file(path, expected, checkout, grace):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or [info.st_dev, info.st_ino] != expected:
        return "file was replaced"
    if info.st_mtime > time.time() - grace:
        return "file changed within the grace period"
    snapshot = review.load_t3(DB)
    if snapshot.has_unmapped_legacy_threads:
        return "no complete T3 ownership"
    if any(review.overlaps(path.parent, p) for p in (*snapshot.projects, *snapshot.threads)):
        return "file directory overlaps a T3 checkout"
    if not snapshot.threads.get(checkout) and (checkout.exists() or checkout.is_symlink()):
        return "named worktree exists without T3 ownership"
    # A removed worktree with no remaining threads has no owner left to protect.
    return settled_threads(snapshot, checkout, grace)


def file_open(path):
    return open_under(path, "open file or incomplete process check")


def sweep_project_files(cfg, apply, sweep_id, entries):
    grace = cfg["settlement_grace_seconds"]
    for project, patterns in sorted(cfg.get("project_cleanup", {}).items()):
        for value in patterns:
            try:
                parent, name = project_pattern(cfg, value)
                matches = sorted(p for p in parent.iterdir() if fnmatch.fnmatchcase(p.name, name))
            except (OSError, ValueError) as exc:
                entries.append({"kind": "project-file", "project": project, "path": value,
                                "status": "keep", "reason": str(exc)})
                continue
            for path in matches:
                entry = {"kind": "project-file", "project": project, "path": str(path), "status": "keep"}
                entries.append(entry)
                try:
                    inspect_project_file(apply, sweep_id, project, path, grace, entry)
                except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                        review.sqlite3.Error, subprocess.SubprocessError) as exc:
                    entry["reason"] = str(exc)


def inspect_project_file(apply, sweep_id, project, path, grace, entry):
    checkout, expected = file_owner(path, project)
    if checkout is None:
        entry["reason"] = "file does not name exactly one worktree of this project"
        return
    entry["checkout"] = str(checkout)
    reason = check_project_file(path, expected, checkout, grace) or file_open(path)
    if reason:
        entry["reason"] = reason
        return
    entry["allocated_kib"] = -(-path.lstat().st_blocks * 512 // 1024)
    if not apply:
        entry["status"] = "eligible"
        return
    if not sweep_id:
        raise ValueError("Deletion requires a sweep audit ID")
    evidence = {"kind": "project-file", "project": project, "path": str(path),
                "checkout": entry["checkout"], "allocated_kib": entry["allocated_kib"],
                "reason": "named worktree's T3 threads settled, grace elapsed, file not open"}
    audit("delete_intent", sweep_id, **evidence)
    reason = check_project_file(path, expected, checkout, grace) or file_open(path)
    if reason:
        entry["reason"] = reason
        audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
        return
    # shortcut: no lock covers foreign tool output; the identity check above bounds the race.
    try:
        path.unlink()
    except OSError as exc:
        entry.update(status="delete_failed", reason=str(exc))
        audit("delete_failed", sweep_id, **dict(evidence, reason=str(exc)))
        return
    entry["status"] = "deleted"
    audit("deleted", sweep_id, **evidence)


def configure_project(cfg, project, value, add):
    if not PROJECT_NAME.fullmatch(project):
        raise ValueError("Project must be its folder name under " + str(WORKTREES))
    projects = cfg.setdefault("project_cleanup", {})
    patterns = projects.setdefault(project, [])
    if add:
        project_pattern(cfg, value)
        if value not in patterns:
            patterns.append(value)
    elif value in patterns:
        patterns.remove(value)
    if not patterns:
        projects.pop(project)
    if not projects:
        cfg.pop("project_cleanup")
    write_json(CONFIG, cfg)


def newest_change(path):
    """Return the latest modification time of any entry in `path`, without following links."""
    newest = path.lstat().st_mtime
    for base, dirs, files in os.walk(path, followlinks=False):
        for name in dirs + files:
            newest = max(newest, (Path(base) / name).lstat().st_mtime)
    return newest


def evidence_owner_state(checkout, grace):
    snapshot = review.load_t3(DB)
    if snapshot.has_unmapped_legacy_threads:
        return "no complete T3 ownership"
    if snapshot.threads.get(checkout):
        return settled_threads(snapshot, checkout, grace)
    if checkout in snapshot.projects or not (checkout.exists() or checkout.is_symlink()):
        # A main checkout has no per-thread record, and a removed worktree has no owner left.
        # Both rely on the retention age and the open-file check.
        return None
    return "checkout exists without T3 ownership"


def check_evidence(workspace, run, days, grace):
    directory(run)
    owner = read_local_json(run / "owner.json")
    if owner["checkout"] != read_local_json(workspace / "owner.json")["checkout"]:
        return "run ownership does not match its workspace"
    if newest_change(run) > time.time() - days * 86400:
        return f"evidence changed within the last {days} days"
    return evidence_owner_state(Path(owner["checkout"]), grace)


def sweep_evidence(cfg, apply, sweep_id, entries):
    days = cfg["evidence_retention_days"]
    managed = build_workspaces(cfg)
    if not days or managed is None or not managed.exists():
        return
    grace = cfg["settlement_grace_seconds"]
    for workspace in sorted(directory(managed).glob("*/*")):
        runs = workspace / "runs"
        if not review.directory(workspace) or not review.directory(runs):
            continue
        for run in sorted(runs.iterdir()):
            entry = {"kind": "evidence", "path": str(run), "status": "keep"}
            entries.append(entry)
            try:
                reason = check_evidence(workspace, run, days, grace) or open_or_mounted(run)
                if reason:
                    entry["reason"] = reason
                    continue
                entry["allocated_kib"] = review.size_kib(run)
                if not apply:
                    entry["status"] = "eligible"
                    continue
                if not sweep_id:
                    raise ValueError("Deletion requires a sweep audit ID")
                evidence = {"kind": "evidence", "path": str(run), "allocated_kib": entry["allocated_kib"],
                            "reason": f"unchanged for {days} days, owners settled, no detected open files"}
                audit("delete_intent", sweep_id, **evidence)
                reason = check_evidence(workspace, run, days, grace) or open_or_mounted(run)
                if reason:
                    entry["reason"] = reason
                    audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
                    continue
                shutil.rmtree(run)
                entry["status"] = "deleted"
                audit("deleted", sweep_id, **evidence)
            except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                    review.sqlite3.Error, subprocess.SubprocessError) as exc:
                entry["reason"] = str(exc)


def xcode_derived_data():
    """Return the DerivedData directory Xcode is set to use, or None when it is per workspace."""
    found = subprocess.run(["/usr/bin/defaults", "read", "com.apple.dt.Xcode", "IDECustomDerivedDataLocation"],
                           capture_output=True, text=True, timeout=30)
    value = found.stdout.strip() if found.returncode == 0 else ""
    path = Path(value).expanduser() if value else XCODE_DEFAULT_DERIVED_DATA
    # A relative location puts DerivedData inside each workspace, which leaves with the worktree.
    return path if path.is_absolute() else None


def xcode_path_hash(path):
    """Xcode's folder suffix: the MD5 of the workspace path, each half written as 14 letters."""
    digest = hashlib.md5(path.encode()).digest()
    letters = ""
    for half in (digest[:8], digest[8:]):
        value, chars = int.from_bytes(half, "big"), []
        for _ in range(14):
            chars.append(chr(ord("a") + value % 26))
            value //= 26
        letters += "".join(reversed(chars))
    return letters


def worktree_of(path):
    if WORKTREES not in path.parents:
        return None
    parts = path.relative_to(WORKTREES).parts
    return WORKTREES / parts[0] / parts[1] if len(parts) >= 2 else None


def candidate_workspaces(checkout, name, listings):
    """Paths in a worktree that Xcode would name `name`: a project, a workspace or a package folder."""
    if checkout not in listings:
        entries = []
        # Generated projects (Tuist, XcodeGen) are usually gitignored, so list ignored entries too.
        # --directory folds a fully ignored folder into one "name/" entry and keeps the listing small.
        for extra in (["--cached"], ["--ignored", "--directory"]):
            listed = subprocess.run(["/usr/bin/git", "-C", str(checkout), "ls-files", "-z", *extra,
                                     "--others", "--exclude-standard"],
                                    capture_output=True, timeout=120, check=True)
            entries += [os.fsdecode(f) for f in listed.stdout.split(b"\0") if f]
        listings[checkout] = entries
    found = set()
    for entry in listings[checkout]:
        relative = Path(entry)
        if entry.endswith("/") and relative.name in (name + ".xcodeproj", name + ".xcworkspace"):
            found.add(checkout / relative)
            continue
        parent = checkout / relative.parent
        if ((relative.name == "Package.swift" and parent.name == name)
                or (relative.name == "project.pbxproj" and parent.name == name + ".xcodeproj")
                or (relative.name == "contents.xcworkspacedata" and parent.name == name + ".xcworkspace")):
            found.add(parent)
    return found


def derived_data_owner(folder, snapshot, listings, owners=None):
    """Return the T3 worktree an Xcode DerivedData folder was built from, or (None, reason).

    `owners` remembers folders matched by name while their worktree existed, keyed by folder name,
    so a folder can still be traced after T3 removes the worktree.
    """
    owners = {} if owners is None else owners
    name, suffix = DERIVED_FOLDER.fullmatch(folder.name).groups()
    plist = folder / "info.plist"
    if plist.is_file() and not plist.is_symlink():
        with plist.open("rb") as stream:
            workspace = plistlib.load(stream).get("WorkspacePath")
        if not isinstance(workspace, str) or xcode_path_hash(workspace) != suffix:
            return None, "info.plist does not match the folder name"
        checkout = worktree_of(Path(os.path.realpath(workspace)))
        return checkout, None if checkout else "built from outside the T3 worktrees"
    # A build that stops early, or a query such as -list, leaves Logs and SourcePackages without info.plist.
    matched = set()
    for checkout in snapshot.threads:
        if worktree_of(checkout) == checkout and checkout.is_dir() and review.directory(checkout):
            if any(xcode_path_hash(str(path)) == suffix
                   for path in candidate_workspaces(checkout, name, listings)):
                matched.add(checkout)
    if len(matched) == 1:
        checkout = matched.pop()
        owners[folder.name] = {"checkout": str(checkout), "identity": identity(folder)}
        return checkout, None
    known = owners.get(folder.name)
    if not matched and known and known.get("identity") == identity(folder):
        checkout = Path(known["checkout"])
        if worktree_of(checkout) == checkout and not checkout.exists():
            return checkout, None
    return None, "no info.plist and no single T3 worktree matches the folder name"


def check_derived(folder, expected, checkout, grace):
    if identity(folder) != expected:
        return "folder was replaced"
    snapshot = review.load_t3(DB)
    if snapshot.has_unmapped_legacy_threads:
        return "no complete T3 ownership"
    if checkout in snapshot.projects or any(review.overlaps(folder, p)
                                            for p in (*snapshot.projects, *snapshot.threads)):
        return "folder belongs to or overlaps a T3 project checkout"
    if snapshot.threads.get(checkout):
        return settled_threads(snapshot, checkout, grace)
    if checkout.exists() or checkout.is_symlink():
        return "worktree exists without T3 ownership"
    # A removed worktree with no remaining threads has no owner left to protect.
    return None


def sweep_derived_data(cfg, apply, sweep_id, entries):
    root = xcode_derived_data()
    if root is None or not root.exists():
        return
    try:
        directory(root)
        managed = build_workspaces(cfg)
        for protected in (WORKTREES, T3_SCRATCH, ROOT, REPORT.parent, *([managed] if managed else [])):
            if review.overlaps(root, protected):
                raise ValueError(f"Xcode DerivedData overlaps managed or T3 storage: {protected}")
        snapshot = review.load_t3(DB)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError,
            review.sqlite3.Error, subprocess.SubprocessError) as exc:
        entries.append({"kind": "derived-data", "path": str(root), "status": "keep", "reason": str(exc)})
        return
    listings = {}
    ledger = REPORT.parent / DERIVED_OWNERS
    try:
        stored = read_local_json(ledger)
    except (FileNotFoundError, ValueError):
        stored = {}
    owners = {name: value for name, value in stored.items()
              if isinstance(value, dict) and (root / name).is_dir()}
    for folder in sorted(root.iterdir()):
        if folder.name.startswith(RETIRED_DERIVED):
            entries.append({"kind": "derived-data", "path": str(folder), "status": "staged",
                            "reason": "interrupted cleanup; preserved for manual review"})
            continue
        if not DERIVED_FOLDER.fullmatch(folder.name) or folder.is_symlink() or not folder.is_dir():
            continue
        entry = {"kind": "derived-data", "path": str(folder), "status": "keep"}
        entries.append(entry)
        try:
            inspect_derived(cfg, apply, sweep_id, root, folder, snapshot, listings, entry, owners)
        except (OSError, ValueError, KeyError, TypeError, RuntimeError, plistlib.InvalidFileException,
                review.sqlite3.Error, subprocess.SubprocessError) as exc:
            entry["reason"] = str(exc)
    owners = {name: value for name, value in owners.items() if (root / name).is_dir()}
    if apply and owners != stored:
        write_json(ledger, owners)


def inspect_derived(cfg, apply, sweep_id, root, folder, snapshot, listings, entry, owners=None):
    checkout, reason = derived_data_owner(folder, snapshot, listings, owners)
    if checkout is None:
        entry["reason"] = reason
        return
    entry["checkout"] = str(checkout)
    grace = cfg["settlement_grace_seconds"]
    expected = identity(folder)
    reason = check_derived(folder, expected, checkout, grace) or open_or_mounted(folder)
    if reason == OPEN_FILES:
        reason = (stop_orphans(folder, (folder, checkout), apply, sweep_id,
                               {"kind": "derived-data", "path": str(folder), "checkout": str(checkout)})
                  or open_or_mounted(folder))
    if reason:
        entry["reason"] = reason
        return
    entry["allocated_kib"] = review.size_kib(folder)
    if not apply:
        entry["status"] = "eligible"
        return
    if not sweep_id:
        raise ValueError("Deletion requires a sweep audit ID")
    parked = root / (RETIRED_DERIVED + uuid.uuid4().hex)
    evidence = {"kind": "derived-data", "path": str(folder), "checkout": entry["checkout"],
                "staged_path": str(parked), "allocated_kib": entry["allocated_kib"],
                "reason": "built from a T3 worktree whose threads settled; no detected open files"}
    audit("delete_intent", sweep_id, **evidence)
    reason = check_derived(folder, expected, checkout, grace)
    if reason:
        entry["reason"] = reason
        audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
        return
    # Detach the folder first so a build that starts now gets a fresh folder instead of a half-deleted one.
    folder.rename(parked)
    entry.update(status="staged", staged_path=str(parked))
    try:
        reason = open_or_mounted(parked) or check_derived(parked, expected, checkout, grace)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError,
            review.sqlite3.Error, subprocess.SubprocessError) as exc:
        reason = str(exc)
    if reason:
        entry["reason"] = reason
        if restore_build(parked, folder):
            entry["status"] = "keep"
            entry.pop("staged_path")
        audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
        return
    try:
        shutil.rmtree(parked)
    except OSError as exc:
        entry["reason"] = str(exc)
        audit("delete_failed", sweep_id, **dict(evidence, reason=str(exc)))
        return
    entry["status"] = "deleted"
    audit("deleted", sweep_id, **evidence)


def dependency_reason(path, checkout, name):
    """Preserve Git data unless the cache contains only reproducible SwiftPM clones."""
    layout = path if name == ".build" else path / "SourcePackages"
    pins = None

    def git(repo, *args):
        return subprocess.run(["/usr/bin/git", "--no-optional-locks", "-C", str(repo), *args],
                              capture_output=True, check=True, timeout=60).stdout.strip()

    def unreadable(error):
        raise error

    for base, dirs, files in os.walk(path, onerror=unreadable):
        repo = Path(base)
        bare = "HEAD" in files and "objects" in dirs
        if ".git" not in dirs + files and not bare:
            continue
        label = repo.relative_to(path)
        parent = "repositories" if bare else "checkouts"
        if repo.parent != layout / parent or (not bare and ".git" not in dirs):
            return f"unexpected Git repository at {label}"
        if pins is None:
            lock = checkout / "Package.resolved"
            if not lock.is_file() and name == "DerivedData":
                locks = list(checkout.glob("*.xcworkspace/xcshareddata/swiftpm/Package.resolved"))
                if not locks:
                    locks = list(checkout.glob("*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"))
                if len(locks) == 1:
                    lock = locks[0]
            if not lock.is_file():
                return f"cannot verify {label} without Package.resolved"
            resolved = json.loads(lock.read_text())
            if not isinstance(resolved, dict) or resolved.get("version") not in (2, 3):
                return f"unsupported Package.resolved format for {label}"
            pins = resolved.get("pins")
            if not isinstance(pins, list) or not all(isinstance(pin, dict) for pin in pins):
                return f"invalid dependency pins for {label}"
        origin = os.fsdecode(git(repo, "remote", "get-url", "origin"))
        logical_layout = checkout / name / layout.relative_to(path)
        if not bare and Path(origin).parent == logical_layout / "repositories":
            origin = os.fsdecode(git(layout / "repositories" / Path(origin).name, "remote", "get-url", "origin"))
        matches = [pin for pin in pins if pin.get("location") == origin and
                   (bare or str(pin.get("identity", "")).lower() == repo.name.lower())]
        if len(matches) != 1 or not re.match(r"^(https?://|ssh://|git@)", origin):
            return f"{label} has no matching remote dependency in Package.resolved"
        revision = matches[0]["state"]["revision"]
        if not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", revision):
            return f"invalid dependency revision for {label}"
        metadata = repo if bare else repo / ".git"
        if (metadata / "worktrees").exists() or git(repo, "for-each-ref", "refs/stash"):
            return f"{label} has a linked worktree or stash"
        if git(repo, "rev-list", "-1", "--all", "--reflog", "--not", revision):
            return f"{label} contains history outside its pinned revision"
        if bare:
            dirs.clear()
            continue
        if (git(repo, "rev-parse", "HEAD").decode() != revision or
                git(repo, "status", "--porcelain", "--ignored", "--untracked-files=all", "--ignore-submodules=none") or
                re.search(rb"(?:^|\x00)[a-zS] ", git(repo, "ls-files", "-vz"))):
            return f"{label} has local changes or differs from its pinned revision"
        dirs.remove(".git")
    return None


def check_checkout_build(path, expected, checkout, name, grace):
    """Reason to keep build output inside a T3 worktree, or None when it can go."""
    if path.is_symlink() or identity(path) != expected:
        return "folder was replaced"
    snapshot = review.load_t3(DB)
    if snapshot.has_unmapped_legacy_threads or not snapshot.threads.get(checkout):
        return "no complete T3 ownership for this worktree"
    if any(review.overlaps(checkout, p) for p in snapshot.projects):
        return "worktree overlaps a project checkout"
    reason = settled_threads(snapshot, checkout, grace)
    if reason:
        return reason
    if path.name != name:
        return dependency_reason(path, checkout, name)
    git = ["/usr/bin/git", "-C", str(checkout)]
    if subprocess.run([*git, "check-ignore", "-q", "--", name], capture_output=True, timeout=60).returncode != 0:
        return "folder is not ignored by git"
    tracked = subprocess.run([*git, "ls-files", "-z", "--", name], capture_output=True, timeout=60, check=True)
    if tracked.stdout:
        return "folder contains tracked files"
    return dependency_reason(path, checkout, name)


def sweep_checkout_builds(cfg, apply, sweep_id, entries):
    """Remove ignored build output that tools left inside settled T3 worktrees.

    A SwiftPM `.build` holds git checkouts, which makes T3 keep the whole worktree, and nothing else
    removes an in-checkout `DerivedData`. This runs only after the user opted in to build cleanup.
    """
    if not cfg.get("build_artifacts_root"):
        return
    try:
        snapshot = review.load_t3(DB)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, review.sqlite3.Error) as exc:
        entries.append({"kind": "checkout-build", "path": str(WORKTREES), "status": "keep", "reason": str(exc)})
        return
    grace = cfg["settlement_grace_seconds"]
    for checkout in sorted(snapshot.threads):
        if worktree_of(checkout) != checkout or checkout.is_symlink() or not checkout.is_dir():
            continue
        for parked in sorted(checkout.glob(RETIRED_DERIVED + "*")):
            entries.append({"kind": "checkout-build", "path": str(parked), "status": "staged",
                            "reason": "interrupted cleanup; preserved for manual review"})
        for name in CHECKOUT_BUILD_NAMES:
            path = checkout / name
            if path.is_symlink() or not path.is_dir():
                continue
            entry = {"kind": "checkout-build", "path": str(path), "checkout": str(checkout), "status": "keep"}
            entries.append(entry)
            try:
                inspect_checkout_build(apply, sweep_id, checkout, name, grace, entry)
            except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                    review.sqlite3.Error, subprocess.SubprocessError) as exc:
                entry["reason"] = str(exc)


def inspect_checkout_build(apply, sweep_id, checkout, name, grace, entry):
    path = checkout / name
    expected = identity(path)
    reason = check_checkout_build(path, expected, checkout, name, grace) or open_or_mounted(path)
    if reason == OPEN_FILES:
        reason = (stop_orphans(path, (path, checkout), apply, sweep_id,
                               {"kind": "checkout-build", "path": str(path), "checkout": str(checkout)})
                  or open_or_mounted(path))
    if reason:
        entry["reason"] = reason
        return
    entry["allocated_kib"] = review.size_kib(path)
    if not apply:
        entry["status"] = "eligible"
        return
    if not sweep_id:
        raise ValueError("Deletion requires a sweep audit ID")
    parked = checkout / (RETIRED_DERIVED + uuid.uuid4().hex)
    evidence = {"kind": "checkout-build", "path": str(path), "checkout": str(checkout),
                "staged_path": str(parked), "allocated_kib": entry["allocated_kib"],
                "reason": "ignored build output in a T3 worktree whose threads settled; no detected open files"}
    audit("delete_intent", sweep_id, **evidence)
    reason = check_checkout_build(path, expected, checkout, name, grace)
    if reason:
        entry["reason"] = reason
        audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
        return
    path.rename(parked)
    entry.update(status="staged", staged_path=str(parked))
    try:
        reason = (open_or_mounted(parked) or check_checkout_build(parked, expected, checkout, name, grace)
                  or ("folder was recreated" if path.exists() or path.is_symlink() else None))
    except (OSError, ValueError, KeyError, TypeError, RuntimeError,
            review.sqlite3.Error, subprocess.SubprocessError) as exc:
        reason = str(exc)
    if reason:
        entry["reason"] = reason
        if restore_build(parked, path):
            entry["status"] = "keep"
            entry.pop("staged_path")
        audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
        return
    try:
        shutil.rmtree(parked)
    except OSError as exc:
        entry["reason"] = str(exc)
        audit("delete_failed", sweep_id, **dict(evidence, reason=str(exc)))
        return
    entry["status"] = "deleted"
    audit("deleted", sweep_id, **evidence)


def report_paths(cfg):
    paths = cfg.get("report_paths") or list(DEFAULT_REPORT_PATHS)
    if cfg.get("build_artifacts_root"):
        paths = [cfg["build_artifacts_root"], *paths]
    return list(dict.fromkeys(str(Path(p).expanduser()) for p in paths))


def measure_sizes(cfg):
    volume = DATA_VOLUME if DATA_VOLUME.is_dir() else Path("/")
    # statvfs reports the whole APFS container. df reports the volume's own use.
    df = subprocess.run(["/bin/df", "-k", str(volume)], capture_output=True, text=True, timeout=30, check=True)
    volume_used = int(df.stdout.splitlines()[1].split()[2])
    sizes = {}
    for path in report_paths(cfg):
        if not os.path.lexists(path):
            sizes[path] = None
            continue
        result = subprocess.run(["/usr/bin/du", "-sk", path], capture_output=True, text=True, timeout=300)
        # du reports unreadable entries on stderr but still prints a usable total.
        sizes[path] = int(result.stdout.split()[0]) if result.stdout.strip() else None
    return {"at": datetime.now(timezone.utc).isoformat(),
            "data_volume_used_kib": volume_used,
            "paths": sizes}


def sizes_file():
    return REPORT.parent / "sizes.jsonl"


def record_sizes(cfg):
    path = sizes_file()
    cutoff = datetime.now(timezone.utc) - timedelta(days=cfg["log_retention_days"])
    kept = [line for line in (path.read_text().splitlines() if path.exists() else [])
            if datetime.fromisoformat(json.loads(line)["at"]) >= cutoff]
    write_file(path, ("\n".join([*kept, json.dumps(measure_sizes(cfg))]) + "\n").encode())


def parse_since(value):
    if value is None:
        return None
    match = re.fullmatch(r"(\d+)([hd])", value)
    if match:
        unit = 3600 if match.group(2) == "h" else 86400
        return datetime.now(timezone.utc) - timedelta(seconds=int(match.group(1)) * unit)
    moment = datetime.fromisoformat(value)
    return moment if moment.tzinfo else moment.astimezone()


def storage_report(cfg, since):
    path = sizes_file()
    records = [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []
    if since is not None:
        records = [r for r in records if datetime.fromisoformat(r["at"]) >= since]
    baseline = records[0] if records else None
    current = measure_sizes(cfg)
    rows = []
    for path_name, now in current["paths"].items():
        before = baseline["paths"].get(path_name) if baseline else None
        change = None if now is None or before is None else now - before
        rows.append({"path": path_name, "baseline_kib": before, "now_kib": now, "change_kib": change})
    rows.sort(key=lambda row: -(row["change_kib"] or 0))
    volume_before = baseline["data_volume_used_kib"] if baseline else None
    return {"baseline_at": baseline["at"] if baseline else None, "now_at": current["at"],
            "data_volume": {"baseline_kib": volume_before, "now_kib": current["data_volume_used_kib"],
                            "change_kib": None if volume_before is None
                            else current["data_volume_used_kib"] - volume_before},
            "paths": rows}


def format_kib(value):
    return "-" if value is None else f"{value / 1048576:.2f} GiB"


def print_storage_report(result):
    print(f"Baseline: {result['baseline_at'] or '(no recorded sweep yet)'}\nNow:      {result['now_at']}")
    volume = result["data_volume"]
    change = volume["change_kib"]
    print(f"Data volume used: {format_kib(volume['now_kib'])}"
          + ("" if change is None else f" (change {change / 1048576:+.2f} GiB)"))
    for row in result["paths"]:
        change = row["change_kib"]
        print(f"{format_kib(row['now_kib']):>12}  "
              f"{'' if change is None else f'{change / 1048576:+.2f} GiB':>12}  {row['path']}")


def sweep(cfg, apply, sweep_id=None):
    if not shutil.rmtree.avoids_symlink_attacks:
        raise RuntimeError("This Python does not support symlink-safe directory removal")
    result = {"generated_at": datetime.now().astimezone().isoformat(),
              "mode": "automatic" if apply else "preview", "entries": []}
    for name in cfg["pools"]:
        pool = directory(directory(ROOT) / name) if (ROOT / name).exists() else None
        if pool is None:
            continue
        for job in sorted(pool.iterdir()):
            if not JOB_NAME.fullmatch(job.name):
                continue
            entry = {"path": str(job / "data"), "status": "keep"}
            result["entries"].append(entry)
            try:
                with lock(job):
                    if {item.name for item in job.iterdir()} != {"lock", "owner.json", "data"}:
                        raise ValueError("Unrecognized contents outside the job's data directory")
                    owner = read_local_json(job / "owner.json")
                    entry["thread"] = owner["thread"]
                    grace = cfg["settlement_grace_seconds"]
                    reason = ready(job, owner, grace)
                    if not reason:
                        reason = open_or_mounted(job / "data") or ready(job, owner, grace)
                    if reason:
                        entry["reason"] = reason
                    else:
                        entry["allocated_kib"] = review.size_kib(job / "data")
                        if apply:
                            # New commands never reuse a job path. Hold its lock through deletion.
                            reason = ready(job, owner, grace)
                            if reason:
                                entry["reason"] = reason
                                continue
                            if not sweep_id:
                                raise ValueError("Deletion requires a sweep audit ID")
                            evidence = {"path": str(job), "thread": owner["thread"],
                                        "checkout": owner["checkout"],
                                        "allocated_kib": entry["allocated_kib"],
                                        "reason": "finished command, settled T3 threads, grace elapsed, no detected open files"}
                            audit("delete_intent", sweep_id, **evidence)
                            reason = ready(job, owner, grace)
                            if reason:
                                entry["reason"] = reason
                                audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
                                continue
                            try:
                                shutil.rmtree(job)
                            except OSError as error:
                                entry.update(status="delete_failed", reason=str(error))
                                audit("delete_failed", sweep_id, **dict(evidence, reason=str(error)))
                            else:
                                entry["status"] = "deleted"
                                audit("deleted", sweep_id, **evidence)
                        else:
                            entry["status"] = "eligible"
            except BlockingIOError:
                entry["reason"] = "command still holds the scratch lock"
            except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                    review.sqlite3.Error, subprocess.SubprocessError) as exc:
                entry["reason"] = str(exc)
    sweep_builds(cfg, apply, sweep_id, result["entries"])
    sweep_project_files(cfg, apply, sweep_id, result["entries"])
    sweep_evidence(cfg, apply, sweep_id, result["entries"])
    sweep_derived_data(cfg, apply, sweep_id, result["entries"])
    sweep_checkout_builds(cfg, apply, sweep_id, result["entries"])
    return result


def allocate(cfg, options, command_scope):
    thread = options.thread or os.environ.get("T3CODE_THREAD_ID")
    if not thread:
        raise ValueError("Run from T3 or pass --thread with the current T3 thread ID")
    if os.environ.get("T3CODE_THREAD_ID", thread) != thread:
        raise ValueError("--thread must match the current T3 thread")
    checkout = thread_checkout(review.load_t3(DB), thread)
    cwd = Path.cwd().resolve()
    if cwd != checkout and checkout not in cwd.parents:
        raise ValueError("Current directory is outside the T3 thread's checkout")
    name = options.pool or next(iter(cfg["pools"]), None)
    if name not in cfg["pools"]:
        raise ValueError("Pool is not configured")
    cmd = options.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        raise ValueError("Pass a foreground command after --")
    pool = ensure_directory(ROOT / name)
    job = pool / uuid.uuid4().hex
    job.mkdir(mode=0o700)
    data = job / "data"
    data.mkdir(mode=0o700)
    fd = command_scope.enter_context(lock(job, create=True))
    registration = {"job": job.name, "job_identity": identity(job),
                    "data_identity": identity(data), "thread": thread, "checkout": str(checkout),
                    "checkout_identity": identity(checkout), "finished_at": None}
    write_json(job / "owner.json", registration)
    return job, registration, cmd, fd


def run(options):
    with ExitStack() as command_scope:
        with config_lock(shared=True):
            cfg = settings()
            configure_storage(cfg)
            job, registration, cmd, fd = allocate(cfg, options, command_scope)
        data = job / "data"
        print(f"Disposable scratch: {data}", file=sys.stderr)
        env = dict(os.environ, AGENT_TMP_DIR=str(data), TMPDIR=str(data) + "/")
        result = subprocess.run(cmd, env=env, pass_fds=(fd,))
        registration["finished_at"] = time.time()
        write_json(job / "owner.json", registration)
        return result.returncode if result.returncode >= 0 else 128 - result.returncode


def pool_name(value):
    path = Path(value).expanduser()
    if path.parent != ROOT or not POOL_NAME.fullmatch(path.name):
        raise ValueError(f"Pool must be a direct child of {ROOT} with a lowercase name")
    return path.name


def configure_pool(cfg, value, add):
    name = pool_name(value)
    if add:
        if name in cfg["pools"]:
            return
        path = ensure_directory(ROOT / name)
        if any(path.iterdir()):
            raise ValueError("An existing pool must be empty before it can be registered")
        cfg["pools"].append(name)
    elif name in cfg["pools"]:
        cfg["pools"].remove(name)
    write_json(CONFIG, cfg)


def launchctl(*args, check=True):
    return subprocess.run(["/bin/launchctl", *args], text=True, capture_output=True,
                          timeout=30, check=check)


def domain():
    return f"gui/{os.getuid()}"


def loaded():
    result = launchctl("print", f"{domain()}/{LABEL}", check=False)
    if result.returncode == 0:
        return True
    if "Could not find service" in result.stderr:
        return False
    if "Could not find domain" in result.stderr:
        return False
    raise RuntimeError(result.stderr.strip() or "Could not read LaunchAgent status")


def definition(minutes):
    return {"Label": LABEL,
            "ProgramArguments": [*SERVICE_COMMAND, "_sweep"],
            "StartInterval": minutes * 60, "RunAtLoad": True}


def installed_definition():
    if not PLIST.exists() and not PLIST.is_symlink():
        return None
    if PLIST.is_symlink() or not PLIST.is_file() or PLIST.stat().st_uid != os.getuid():
        raise ValueError("Refusing to touch an unowned or symlinked LaunchAgent")
    try:
        old = plistlib.loads(PLIST.read_bytes())
        interval = old["StartInterval"]
        if (type(interval) is not int or interval % 60 or not 60 <= interval <= MAX_MINUTES * 60
                or old != definition(interval // 60)):
            raise ValueError("definition does not match this checkout")
    except (ValueError, KeyError, TypeError) as error:
        raise ValueError(f"Refusing to replace or remove {PLIST}: {error}") from error
    return old


def configure_service(minutes=None):
    old = installed_definition()
    running = loaded()
    if running and old is None:
        raise RuntimeError("A service with this label is loaded without a matching plist")
    new = definition(minutes) if minutes is not None else None
    if new == old and running == (new is not None):
        return
    if running:
        launchctl("bootout", f"{domain()}/{LABEL}")
    try:
        if new is None:
            PLIST.unlink()
        else:
            ensure_directory(PLIST.parent)
            if new != old:
                write_file(PLIST, plistlib.dumps(new))
            launchctl("bootstrap", domain(), str(PLIST))
    except (OSError, ValueError, subprocess.SubprocessError):
        if old is None:
            if PLIST.exists():
                PLIST.unlink()
        else:
            write_file(PLIST, plistlib.dumps(old))
            if running:
                launchctl("bootstrap", domain(), str(PLIST))
        raise


def config_details(cfg):
    return {"config": str(CONFIG), "deletion_boundary": str(ROOT),
            "pools": [str(ROOT / name) for name in cfg["pools"]],
            "interval_minutes": cfg["interval_minutes"],
            "settlement_grace_minutes": cfg["settlement_grace_seconds"] // 60,
            "launch_agent": str(PLIST), "latest_sweep_file": str(REPORT),
            "audit_directory": str(AUDIT_DIR), "log_retention_days": cfg["log_retention_days"],
            "build_artifacts_root": cfg.get("build_artifacts_root"),
            "project_cleanup": cfg.get("project_cleanup", {}),
            "evidence_retention_days": cfg["evidence_retention_days"],
            "report_paths": report_paths(cfg), "size_history": str(sizes_file()),
            "xcode_derived_data": str(xcode_derived_data() or "")}


def status():
    result = {"loaded": loaded(), "launch_agent": str(PLIST), "latest_sweep_file": str(REPORT),
              "audit_directory": str(AUDIT_DIR)}
    try:
        report = read_local_json(REPORT)
    except FileNotFoundError:
        report = None
    result["last_sweep"] = report
    return result


def scheduled_sweep():
    sweep_id = uuid.uuid4().hex
    failed = False
    try:
        cfg = settings(missing_ok=False)
        configure_storage(cfg)
        audit("sweep_started", sweep_id)
        expire_audit(cfg["log_retention_days"])
        result = sweep(cfg, apply=True, sweep_id=sweep_id)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError,
            review.sqlite3.Error, subprocess.SubprocessError) as error:
        result = {"mode": "automatic", "generated_at": datetime.now().astimezone().isoformat(),
                  "error": str(error), "entries": []}
        failed = True
    else:
        try:
            record_sizes(cfg)
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
            result["size_record_error"] = str(error)
    ensure_directory(REPORT.parent)
    result["sweep_id"] = sweep_id
    write_json(REPORT, result)
    audit("sweep_finished", sweep_id, report=result)
    return int(failed)


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(prog="ai-butler", description=__doc__,
                                     epilog="Start with ai-butler list, then ai-butler preview to see what cleanup would keep or remove.")
    commands = parser.add_subparsers(dest="action", required=True)
    listing = commands.add_parser("list", help="List managed paths and configuration")
    listing.add_argument("--json", action="store_true")
    commands.add_parser("add", help="Register a new or empty pool").add_argument("path")
    commands.add_parser("remove", help="Unregister a pool without deleting it").add_argument("path")
    install = commands.add_parser("install", help="Install or load the user LaunchAgent")
    install.add_argument("--hooks", action="store_true", help="Also configure agent startup hooks")
    install.add_argument("--artifact-root", type=Path,
                         help="Local artifact storage for --hooks")
    commands.add_parser("uninstall", help="Unload and remove the LaunchAgent")
    commands.add_parser("setInterval", help="Set sweep interval in minutes (0 resets to 60)").add_argument("minutes", type=int)
    commands.add_parser("setSettlementGracePeriod", help="Set settlement grace in minutes").add_argument("minutes", type=int)
    commands.add_parser("setLogRetention", help="Set audit retention in days (default 7)").add_argument("days", type=int)
    commands.add_parser("setEvidenceRetention",
                        help="Delete run evidence this many days after it last changed (default 7, 0 keeps it)"
                        ).add_argument("days", type=int)
    report = commands.add_parser("report", help="Show storage growth of known large locations; remove nothing")
    report.add_argument("--since", help="ISO time, or a duration such as 6h or 2d (default: oldest record)")
    report.add_argument("--json", action="store_true")
    for name, text in (("addProjectCleanup", "Clean a project's stray files after its worktree settles"),
                       ("removeProjectCleanup", "Stop cleaning a project's stray-file pattern")):
        project = commands.add_parser(name, help=text)
        project.add_argument("project", help="Folder name under ~/workspace/worktrees")
        project.add_argument("pattern", help="Canonical directory plus filename glob")
    preview = commands.add_parser("preview", help="Show what cleanup would keep or remove")
    preview.add_argument("--summary", action="store_true", help="Print a decision and reason per path (default: JSON)")
    commands.add_parser("status", help="Show LaunchAgent and last sweep status")
    hook = commands.add_parser("artifact-hook", help="Allocate workspace and run output paths")
    hook.add_argument("provider", choices=("codex", "claude", "cursor", "antigravity", "other"))
    hook.add_argument("--cwd")
    hook.add_argument("--session")
    guarding = commands.add_parser("guard", help="PreToolUse hook: block xcodebuild without -derivedDataPath")
    guarding.add_argument("provider", choices=("codex", "claude", "antigravity"))
    foreground = commands.add_parser("run", help="Run one foreground command with disposable temp")
    foreground.description = "From a T3 checkout, run: ai-butler run -- COMMAND [ARG ...]"
    foreground.add_argument("--thread", help="T3 thread ID when the environment does not supply one")
    foreground.add_argument("--pool", help="Registered scratch pool to use (default: tmp)")
    foreground.add_argument("command", nargs=argparse.REMAINDER)
    try:
        if sys.argv[1:] == ["_sweep"]:
            with config_lock():
                # shortcut: local T3 projections cannot lock turn startup; scratch is single-use.
                return scheduled_sweep()
        options = parser.parse_args()
        action = options.action
        if action == "artifact-hook":
            return artifact_hook(options)
        if action == "guard":
            try:
                return guard(options)
            except Exception as exc:  # A broken guard must never block an agent's tool call.
                print(f"ai-butler guard: {exc}", file=sys.stderr)
                return 0
        if action == "run":
            return run(options)
        if action == "status":
            configure_storage(settings())
            print(json.dumps(status(), indent=2))
            return 0
        if action == "report":
            cfg = settings()
            configure_storage(cfg)
            result = storage_report(cfg, parse_since(options.since))
            if options.json:
                print(json.dumps(result, indent=2))
            else:
                print_storage_report(result)
            return 0
        if action in ("list", "preview"):
            cfg = settings()
            configure_storage(cfg)
            result = config_details(cfg) if action == "list" else sweep(cfg, apply=False)
            if action == "list" and not options.json:
                print(f"Config: {CONFIG}\nSweep: {cfg['interval_minutes']} min; "
                      f"settlement grace: {cfg['settlement_grace_seconds'] // 60} min")
                print(f"Audit logs: {AUDIT_DIR} ({cfg['log_retention_days']} days)")
                days = cfg["evidence_retention_days"]
                print(f"Run evidence: deleted {days} days after its last change" if days
                      else "Run evidence: kept until removed by hand")
                if cfg.get("build_artifacts_root"):
                    print(f"Build artifacts: {cfg['build_artifacts_root']}")
                print("Xcode DerivedData: " + (result["xcode_derived_data"] or "inside each workspace")
                      + " (folders built from settled T3 worktrees)")
                for project, patterns in sorted(result["project_cleanup"].items()):
                    print(f"Project {project}: " + ", ".join(patterns))
                print("\n".join(result["pools"]) or "(no pools configured)")
            elif action == "preview" and options.summary:
                if not result["entries"]:
                    print("No cleanup candidates.")
                for entry in result["entries"]:
                    reason = entry.get("reason") or "all cleanup checks passed"
                    print(f"{entry['status']}  {entry.get('path', '')}  ({reason})")
            else:
                print(json.dumps(result, indent=2))
            return 0
        with config_lock():
            if action == "uninstall":
                configure_service()
                return 0
            cfg = settings()
            configure_storage(cfg)
            if action == "install":
                if options.artifact_root is not None and not options.hooks:
                    raise ValueError("--artifact-root requires --hooks")
                ensure_directory(ROOT)
                if options.hooks:
                    current = cfg.get("build_artifacts_root")
                    selected = options.artifact_root or Path(current or DATA / "Artifacts")
                    selected = str(selected.expanduser())
                    if current and current != selected:
                        raise ValueError("Stop the service and edit build_artifacts_root to change storage")
                    cfg["build_artifacts_root"] = selected
                    ensure_directory(build_workspaces(cfg))
                    changes = hook_updates()
                    write_json(CONFIG, cfg)
                    configure_service(cfg["interval_minutes"])
                    for path, data in changes:
                        write_json(path, data)
                    print("Startup hooks installed. Trust the new Codex hook in /hooks if prompted.")
                else:
                    if not CONFIG.exists():
                        write_json(CONFIG, cfg)
                    configure_service(cfg["interval_minutes"])
            elif action in ("add", "remove"):
                configure_pool(cfg, options.path, action == "add")
            elif action in ("addProjectCleanup", "removeProjectCleanup"):
                configure_project(cfg, options.project, options.pattern, action == "addProjectCleanup")
            elif action == "setLogRetention":
                if not 1 <= options.days <= 36500:
                    raise ValueError("Days must be between 1 and 36500")
                cfg["log_retention_days"] = options.days
                write_json(CONFIG, cfg)
            elif action == "setEvidenceRetention":
                if not 0 <= options.days <= 36500:
                    raise ValueError("Days must be between 0 and 36500")
                cfg["evidence_retention_days"] = options.days
                write_json(CONFIG, cfg)
            else:
                minutes = options.minutes
                if action == "setInterval" and minutes == 0:
                    minutes = DEFAULT_INTERVAL
                if not 1 <= minutes <= MAX_MINUTES:
                    raise ValueError(f"Minutes must be between 1 and {MAX_MINUTES}")
                if action == "setInterval":
                    previous = cfg.copy()
                    cfg["interval_minutes"] = minutes
                    installed = installed_definition() is not None
                    write_json(CONFIG, cfg)
                    if installed:
                        try:
                            configure_service(minutes)
                        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
                            write_json(CONFIG, previous)
                            raise
                else:
                    cfg["settlement_grace_seconds"] = minutes * 60
                    write_json(CONFIG, cfg)
        return 0
    except subprocess.CalledProcessError as exc:
        print(f"ai-butler: {exc.stderr.strip() if exc.stderr else exc}", file=sys.stderr)
        return 1
    except (OSError, ValueError, KeyError, TypeError, RuntimeError,
            review.sqlite3.Error, subprocess.SubprocessError) as exc:
        print(f"ai-butler: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    # End quietly when a reader such as head closes the report pipe.
    if sys.argv[1:2] in (["preview"], ["report"], ["list"]):
        import signal
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
