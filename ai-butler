sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location(
    "artifact_review", Path(__file__).resolve().with_name("agent-artifact-review.py")
)
review = importlib.util.module_from_spec(spec)
spec.loader.exec_module(review)

HOME = Path.home()
DATA = HOME / "Library/Application Support/AI Butler"
ROOT = DATA / "Scratch"
CONFIG = HOME / ".config/ai-butler/config.json"
REPORT = DATA / "State/latest.json"
AUDIT_DIR = REPORT.parent / "audit"
LABEL = "com.local.ai-butler"
PLIST = HOME / "Library/LaunchAgents" / (LABEL + ".plist")
SCRIPT = Path(__file__).resolve()
SERVICE_COMMAND = ["/usr/bin/python3", str(SCRIPT)]  # The Homebrew formula uses its stable opt path.
DEFAULT_INTERVAL = 60
DEFAULT_GRACE = 5
DEFAULT_RETENTION = 7
MAX_MINUTES = (2**31 - 1) // 60
DB = HOME / ".t3/userdata/statev2.sqlite"
WORKTREES = HOME / "workspace/worktrees"
T3_SCRATCH = HOME / ".t3/scratch"
POOL_NAME = re.compile(r"[a-z][a-z0-9-]{0,31}")
JOB_NAME = re.compile(r"[0-9a-f]{32}")


def settings(missing_ok=True):
    try:
        cfg = read_local_json(CONFIG)
    except FileNotFoundError:
        if not missing_ok:
            raise
        return {"pools": ["tmp"], "settlement_grace_seconds": DEFAULT_GRACE * 60,
                "interval_minutes": DEFAULT_INTERVAL, "log_retention_days": DEFAULT_RETENTION}
    pools = cfg["pools"]
    grace = cfg["settlement_grace_seconds"]
    interval = cfg["interval_minutes"]
    retention = cfg.setdefault("log_retention_days", DEFAULT_RETENTION)
    if (not isinstance(pools, list)
            or any(not isinstance(p, str) or not POOL_NAME.fullmatch(p) for p in pools)
            or len(set(pools)) != len(pools) or type(grace) is not int
            or not 60 <= grace <= MAX_MINUTES * 60 or grace % 60
            or type(interval) is not int or not 1 <= interval <= MAX_MINUTES
            or type(retention) is not int or not 1 <= retention <= 36500):
        raise ValueError("Invalid pool or timing settings in " + str(CONFIG))
    return cfg


def configure_storage(cfg):
    global ROOT, REPORT, AUDIT_DIR
    root = Path(cfg.get("scratch_root", str(ROOT))).expanduser()
    state = Path(cfg.get("state_directory", str(REPORT.parent))).expanduser()
    if (not root.is_absolute() or not state.is_absolute()
            or root.resolve() != root or state.resolve() != state
            or HOME not in root.parents or HOME not in state.parents
            or review.overlaps(root, state)):
        raise ValueError("Scratch and state must be separate canonical directories under your home")
    ROOT, REPORT, AUDIT_DIR = root, state / "latest.json", state / "audit"


def directory(path):
    if not review.directory(path) or path.is_symlink() or path.stat().st_uid != os.getuid():
        raise ValueError(f"Not an owned, canonical directory: {path}")
    return path


def identity(path):
    info = directory(path).stat()
    return [info.st_dev, info.st_ino]


def write_file(path, data):
    with tempfile.NamedTemporaryFile(dir=directory(path.parent), delete=False) as stream:
        try:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            stream.close()
            os.replace(stream.name, path)
        finally:
            Path(stream.name).unlink(missing_ok=True)


def write_json(path, data):
    write_file(path, (json.dumps(data, indent=2) + "\n").encode())


def ensure_directory(path):
    if not path.exists():
        ensure_directory(path.parent)
        path.mkdir(mode=0o700, exist_ok=True)
    return directory(path)


def read_local_json(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise ValueError(f"Not an owned metadata file: {path}")
        return json.load(stream)


def audit(event, sweep_id, **fields):
    now = datetime.now(timezone.utc)
    path = ensure_directory(AUDIT_DIR) / f"{now.date().isoformat()}.jsonl"
    flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or info.st_mode & 0o077):
            raise ValueError("The audit log must be a private, owned regular file")
        stream.write(json.dumps({"at": now.isoformat(),
                                 "event": event, "sweep_id": sweep_id, **fields}) + "\n")
        stream.flush()
        os.fsync(stream.fileno())


def expire_audit(days):
    cutoff = datetime.now(timezone.utc).date() - timedelta(days=days - 1)
    for path in directory(AUDIT_DIR).iterdir():
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}\.jsonl", path.name):
            continue
        try:
            day = date.fromisoformat(path.stem)
        except ValueError:
            continue
        info = path.lstat()
        if (day < cutoff and stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid()
                and info.st_nlink == 1 and not info.st_mode & 0o077):
            path.unlink()


@contextmanager
def lock_file(path, create=0, nonblocking=True, shared=False):
    flags = os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK
    directory(path.parent)
    fd = os.open(path, flags | create, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise ValueError("Invalid lock file")
        fcntl.flock(fd, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
                    | (fcntl.LOCK_NB if nonblocking else 0))
        yield fd
    finally:
        os.close(fd)


def lock(job, create=False):
    return lock_file(job / "lock", os.O_CREAT | os.O_EXCL if create else 0)


@contextmanager
def config_lock(shared=False):
    ensure_directory(CONFIG.parent)
    with lock_file(CONFIG.with_name("lock"), os.O_CREAT, nonblocking=False, shared=shared):
        yield


def workspace_lock(workspace, nonblocking=False):
    return lock_file(workspace / ".build-cleanup.lock", os.O_CREAT, nonblocking=nonblocking)


def thread_checkout(snapshot, thread, allow_missing=False):
    matches = [path for path, rows in snapshot.threads.items()
               if any(tid == thread for tid, _ in rows)]
    if (snapshot.has_unmapped_legacy_threads or len(matches) != 1
            or not any(root in matches[0].parents for root in (WORKTREES, T3_SCRATCH))):
        raise ValueError("Thread must map to an exact managed T3 worktree or scratch checkout")
    checkout = matches[0]
    if not allow_missing or checkout.exists():
        directory(checkout)
    if any(review.overlaps(checkout, p) and p != T3_SCRATCH for p in snapshot.projects):
        raise ValueError("Thread overlaps a T3 project checkout")
    if any(review.overlaps(ROOT, path) for path in (*snapshot.projects, *snapshot.threads)):
        raise ValueError("A T3 checkout overlaps the disposable storage root")
    return checkout


def settled_threads(snapshot, checkout, grace):
    related = set()
    for path, rows in snapshot.threads.items():
        if review.overlaps(path, checkout):
            related.update(tid for tid, _ in rows)
    descendants = {}
    for tid, row in snapshot.thread_rows.items():
        parent = (row.get("lineage") or {}).get("parentThreadId")
        if parent is not None:
            descendants.setdefault(parent, []).append(tid)
    pending = list(related)
    while pending:
        for child in descendants.get(pending.pop(), ()):
            if child not in related:
                related.add(child)
                pending.append(child)
    for tid in related:
        row = snapshot.thread_rows[tid]
        settled = row["settledAt"]
        if (not settled or row.get("settledOverride") == "active" or row.get("pinnedAt")
                or row.get("snoozedUntil") or tid in snapshot.active):
            return "T3 owner or related thread is active or not settled"
        timestamp = datetime.fromisoformat(settled.replace("Z", "+00:00"))
        if timestamp.tzinfo is None or time.time() - timestamp.timestamp() < grace:
            return "T3 thread settled within the grace period"
    return None


def ready(job, owner, grace):
    if owner["job"] != job.name or owner["job_identity"] != identity(job):
        return "registration does not match this directory"
    data = directory(job / "data")
    if owner["data_identity"] != identity(data):
        return "scratch directory has been replaced"
    if len({path.stat().st_dev for path in (ROOT, job.parent, job, data)}) != 1:
        return "scratch is on another filesystem"
    if owner["finished_at"] is None or not owner["finished_at"] <= time.time() - grace:
        return "command has not finished or is still within the grace period"
    snapshot = review.load_t3(DB)
    checkout = thread_checkout(snapshot, owner["thread"], allow_missing=True)
    if (str(checkout) != owner["checkout"]
            or checkout.exists() and identity(checkout) != owner["checkout_identity"]):
        return "T3 checkout no longer matches the registration"
    return settled_threads(snapshot, checkout, grace)


def open_or_mounted(data, preserve_evidence=False):
    def fail(exc):
        raise exc
    device = data.stat().st_dev
    for base, dirs, files in os.walk(data, followlinks=False, onerror=fail):
        for name in dirs + files:
            if preserve_evidence and name.endswith((".xcresult", ".xcarchive", ".ipa")):
                return "build directory contains a test result, archive, or export"
            if (Path(base) / name).lstat().st_dev != device:
                return "scratch contains another filesystem"
    opened = subprocess.run(["/usr/sbin/lsof", "-nP", "+D", str(data)], capture_output=True, timeout=30)
    if opened.returncode != 1 or opened.stdout or opened.stderr:
        return "open files or incomplete process check"
    return None


def build_workspaces(cfg):
    value = cfg.get("build_artifacts_root")
    if value is None:
        return None
    root = Path(value).expanduser()
    if (HOME not in root.parents or root.resolve() != root or root == WORKTREES
            or WORKTREES in root.parents or root in WORKTREES.parents):
        raise ValueError("Build artifact root must be canonical and separate from worktrees")
    managed = root / "workspaces"
    if any(review.overlaps(managed, path) for path in (ROOT, REPORT.parent, T3_SCRATCH)):
        raise ValueError("Build workspaces overlap scratch, state, or T3 storage")
    return managed


def build_checkout(workspace, owner):
    checkout = Path(owner["checkout"])
    if (WORKTREES not in checkout.parents or checkout.resolve() != checkout
            or len(checkout.relative_to(WORKTREES).parts) != 2
            or workspace.name != hashlib.sha256(str(checkout).encode()).hexdigest()[:16]):
        raise ValueError("Ownership does not match a canonical managed worktree")
    return checkout


def artifact_hook(options):
    payload = json.load(sys.stdin) if options.provider != "other" and not options.cwd else {}
    provider = options.provider
    if provider == "claude" and (payload.get("cursor_version") or os.getenv("CURSOR_VERSION")):
        provider = "cursor"
    roots = payload.get("workspace_roots") or []
    cwd = Path(options.cwd or payload.get("cwd") or (roots[0] if roots else Path.cwd()))
    cwd = cwd.resolve(strict=True)
    if not cwd.is_dir():
        raise ValueError("Hook checkout must be a directory")
    checkout = next((p for p in (cwd, *cwd.parents) if (p / ".git").exists()), cwd)
    session = (options.session or payload.get("session_id")
               or payload.get("conversation_id") or uuid.uuid4().hex)
    with ExitStack() as scope:
        managed = build_workspaces(settings(missing_ok=False))
        if managed is None:
            raise ValueError("Artifact hooks are not configured")
        name = re.sub(r"[^a-zA-Z0-9._-]+", "-", checkout.name).strip(".-")[:48] or "workspace"
        workspace = ensure_directory(managed / name / hashlib.sha256(str(checkout).encode()).hexdigest()[:16])
        scope.enter_context(workspace_lock(workspace))
        marker = workspace / "owner.json"
        if not marker.exists() and not marker.is_symlink():
            if any(path.name != ".build-cleanup.lock" for path in workspace.iterdir()):
                raise ValueError("Existing workspace has no ownership record")
            owner = {"checkout": str(checkout), "created_at": datetime.now(timezone.utc).isoformat(),
                     "retention": "protected-until-explicit-review"}
            if (WORKTREES in checkout.parents and len(checkout.relative_to(WORKTREES).parts) == 2):
                owner["build_cleanup"] = {"version": 1, "workspace_identity": identity(workspace),
                                          "checkout_identity": identity(checkout)}
            write_json(marker, owner)
        elif read_local_json(marker)["checkout"] != str(checkout):
            raise ValueError("Artifact workspace has a different owner")
        run_dir = ensure_directory(workspace / "runs" / (
            provider + "-" + hashlib.sha256(session.encode()).hexdigest()[:16]))
        run_owner = run_dir / "owner.json"
        if not run_owner.exists() and not run_owner.is_symlink():
            write_json(run_owner, {"checkout": str(checkout), "provider": provider, "session_id": session,
                                   "created_at": datetime.now(timezone.utc).isoformat(),
                                   "retention": "protected-until-explicit-review"})
        else:
            data = read_local_json(run_owner)
            if (data["checkout"], data["provider"], data["session_id"]) != (str(checkout), provider, session):
                raise ValueError("Artifact run has a different owner")
        env = {"AGENT_ARTIFACTS_ROOT": str(managed.parent), "AGENT_CHECKOUT": str(checkout),
               "AGENT_WORKSPACE_ARTIFACTS": str(workspace), "AGENT_RUN_DIR": str(run_dir)}
        for key, path in (("XCODE", workspace / "build/xcode"),
                          ("SWIFTPM", workspace / "build/swiftpm"),
                          ("LOG", run_dir / "logs"), ("RESULTS", run_dir / "results"),
                          ("SCREENSHOTS", run_dir / "screenshots"), ("TMP", run_dir / "tmp")):
            env[f"AGENT_{key}_DIR"] = str(ensure_directory(path))
        env_file = run_dir / "env.sh"
        content = "".join(f"export {key}={shlex.quote(value)}\n" for key, value in env.items())
        write_file(env_file, content.encode())
    context = (f"Source {shlex.quote(str(env_file))} before building. "
               "Use the assigned DerivedData or SwiftPM scratch path and keep evidence in the run directory.")
    if options.provider == "claude" and provider == "claude" and os.getenv("CLAUDE_ENV_FILE"):
        with open(os.environ["CLAUDE_ENV_FILE"], "a") as stream:
            stream.write("\n" + content)
    if options.provider == "cursor":
        output = {"env": env, "additional_context": context}
    elif provider in ("codex", "claude"):
        output = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}
    else:
        output = {"env_file": str(env_file), "env": env, "context": context}
    print(json.dumps(output))
    return 0


def hook_updates():
    changes = []
    for provider, relative in (("codex", ".codex/hooks.json"), ("claude", ".claude/settings.json"),
                               ("cursor", ".cursor/hooks.json")):
        path = HOME / relative
        if not path.parent.is_dir():
            continue
        try:
            data = read_local_json(path)
        except FileNotFoundError:
            data = {"version": 1} if provider == "cursor" else {}
        hooks = data.setdefault("hooks", {}).setdefault(
            "sessionStart" if provider == "cursor" else "SessionStart", [])
        command = shlex.join([*SERVICE_COMMAND, "artifact-hook", provider])
        legacy = shlex.join(["/usr/bin/python3", str(HOME / ".agents/hooks/artifact-storage.py"), provider])
        matches = [hook for group in hooks
                   for hook in ([group] if provider == "cursor" else group.get("hooks", []))
                   if hook.get("command") in (command, legacy)]
        if len(matches) > 1:
            raise ValueError(f"Multiple artifact hooks in {path}; keep just one before installing")
        if matches and matches[0]["command"] == command:
            continue
        if matches:
            matches[0]["command"] = command
        elif provider == "cursor":
            hooks.append({"command": command, "timeout": 5})
        else:
            hooks.append({"hooks": [{"type": "command", "command": command, "timeout": 5}]})
        changes.append((path, data))
    return changes


def check_build(workspace, path, expected, owner, grace):
    if identity(path) != expected or path.stat().st_dev != workspace.stat().st_dev:
        return "build directory was replaced or is on another filesystem"
    if read_local_json(workspace / "owner.json") != owner:
        return "build ownership changed"
    checkout = build_checkout(workspace, owner)
    if checkout.exists() and identity(checkout) != owner["build_cleanup"]["checkout_identity"]:
        return "worktree has been replaced"
    for entry in path.iterdir():
        if entry.name not in {"xcode", "swiftpm", "native"} or not review.directory(entry):
            return "unrecognized output in the build directory"
    snapshot = review.load_t3(DB)
    if snapshot.has_unmapped_legacy_threads or not snapshot.threads.get(checkout):
        return "no complete T3 ownership for this worktree"
    if any(review.overlaps(checkout, p) for p in snapshot.projects):
        return "worktree overlaps a project checkout"
    if any(review.overlaps(workspace, p) for p in (*snapshot.projects, *snapshot.threads)):
        return "build storage overlaps a T3 checkout"
    for protected in (*snapshot.projects, *snapshot.threads):
        if protected == checkout or not protected.exists():
            continue
        for alias in (protected / ".build", protected / "DerivedData"):
            if alias.is_symlink() and review.overlaps(workspace / "build", alias.resolve()):
                return "another T3 checkout refers to this build directory"
    return settled_threads(snapshot, checkout, grace)


def restore_build(parked, build):
    rename = ctypes.CDLL(None, use_errno=True).renamex_np
    rename.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
    if rename(os.fsencode(parked), os.fsencode(build), 0x00000004) == 0:  # RENAME_EXCL
        return True
    code = ctypes.get_errno()
    if code == errno.EEXIST:
        return False
    raise OSError(code, os.strerror(code), str(parked), str(build))


def sweep_builds(cfg, apply, sweep_id, entries):
    managed = build_workspaces(cfg)
    if managed is None or not managed.exists():
        return
    directory(managed)
    for workspace in sorted(managed.glob("*/*")):
        build = workspace / "build"
        if not review.directory(workspace):
            continue
        for parked in sorted(workspace.glob(".retired-build-*")):
            entries.append({"kind": "build", "path": str(parked), "status": "staged",
                            "reason": "interrupted cleanup; preserved for manual review"})
        if not build.exists() and not build.is_symlink():
            continue
        entry = {"kind": "build", "path": str(build), "status": "keep"}
        entries.append(entry)
        try:
            inspect_build(cfg, apply, sweep_id, workspace, build, entry)
        except BlockingIOError:
            entry["reason"] = "artifact setup holds the workspace lock"
        except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                review.sqlite3.Error, subprocess.SubprocessError) as exc:
            entry["reason"] = str(exc)


def inspect_build(cfg, apply, sweep_id, workspace, build, entry):
    with ExitStack() as scope:
        directory(workspace)
        owner = read_local_json(workspace / "owner.json")
        marker = owner.get("build_cleanup")
        if not isinstance(marker, dict) or marker.get("version") != 1:
            entry["reason"] = "build output was not opted in at allocation"
            return
        if apply:
            # Only hold the workspace lock for the final rename and validation.
            # Preliminary inspection can be slow and does not change the workspace.
            guard = workspace / ".build-cleanup.lock"
            if not guard.is_file() or guard.is_symlink():
                raise ValueError("Missing artifact workspace lock")
        if marker["workspace_identity"] != identity(workspace):
            raise ValueError("build registration does not match its workspace")
        entry["checkout"] = owner["checkout"]
        expected = identity(build)
        grace = cfg["settlement_grace_seconds"]
        reason = check_build(workspace, build, expected, owner, grace)
        if not reason:
            reason = open_or_mounted(build, preserve_evidence=True)
        if reason:
            entry["reason"] = reason
            return
        entry["allocated_kib"] = review.size_kib(build)
        if not apply:
            entry["status"] = "eligible"
            return
        if not sweep_id:
            raise ValueError("Deletion requires a sweep audit ID")
        parked = workspace / (".retired-build-" + uuid.uuid4().hex)
        evidence = {"kind": "build", "path": str(build), "checkout": entry["checkout"],
                    "staged_path": str(parked), "allocated_kib": entry["allocated_kib"],
                    "reason": "all T3 owners settled and no detected open files"}
        scope.enter_context(lock_file(guard))
        reason = check_build(workspace, build, expected, owner, grace)
        if reason:
            entry["reason"] = reason
            return
        audit("delete_intent", sweep_id, **evidence)
        reason = check_build(workspace, build, expected, owner, grace)
        if reason:
            entry["reason"] = reason
            audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
            return
        # shortcut: T3 has no cross-process startup lock; detach the old generation
        # so a resumed build can only recreate the original path, not write into it.
        build.rename(parked)
        entry["staged_path"] = str(parked)
        entry["status"] = "staged"
        try:
            reason = (open_or_mounted(parked, preserve_evidence=True)
                      or check_build(workspace, parked, expected, owner, grace)
                      or ("build was recreated" if build.exists() or build.is_symlink() else None))
        except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                review.sqlite3.Error, subprocess.SubprocessError) as exc:
            reason = str(exc)
        if reason:
            entry["reason"] = reason
            if restore_build(parked, build):
                entry["status"] = "keep"
                entry.pop("staged_path")
            audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
            return
        scope.close()
        try:
            shutil.rmtree(parked)
        except OSError as exc:
            entry["reason"] = str(exc)
            audit("delete_failed", sweep_id, **dict(evidence, reason=str(exc)))
            return
        entry["status"] = "deleted"
        audit("deleted", sweep_id, **evidence)


def sweep(cfg, apply, sweep_id=None):
    if not shutil.rmtree.avoids_symlink_attacks:
        raise RuntimeError("This Python does not support symlink-safe directory removal")
    result = {"generated_at": datetime.now().astimezone().isoformat(),
              "mode": "automatic" if apply else "preview", "entries": []}
    for name in cfg["pools"]:
        pool = directory(directory(ROOT) / name) if (ROOT / name).exists() else None
        if pool is None:
            continue
        for job in sorted(pool.iterdir()):
            if not JOB_NAME.fullmatch(job.name):
                continue
            entry = {"path": str(job / "data"), "status": "keep"}
            result["entries"].append(entry)
            try:
                with lock(job):
                    if {item.name for item in job.iterdir()} != {"lock", "owner.json", "data"}:
                        raise ValueError("Unrecognized contents outside the job's data directory")
                    owner = read_local_json(job / "owner.json")
                    entry["thread"] = owner["thread"]
                    grace = cfg["settlement_grace_seconds"]
                    reason = ready(job, owner, grace)
                    if not reason:
                        reason = open_or_mounted(job / "data") or ready(job, owner, grace)
                    if reason:
                        entry["reason"] = reason
                    else:
                        entry["allocated_kib"] = review.size_kib(job / "data")
                        if apply:
                            # New commands never reuse a job path. Hold its lock through deletion.
                            reason = ready(job, owner, grace)
                            if reason:
                                entry["reason"] = reason
                                continue
                            if not sweep_id:
                                raise ValueError("Deletion requires a sweep audit ID")
                            evidence = {"path": str(job), "thread": owner["thread"],
                                        "checkout": owner["checkout"],
                                        "allocated_kib": entry["allocated_kib"],
                                        "reason": "finished command, settled T3 threads, grace elapsed, no detected open files"}
                            audit("delete_intent", sweep_id, **evidence)
                            reason = ready(job, owner, grace)
                            if reason:
                                entry["reason"] = reason
                                audit("delete_cancelled", sweep_id, **dict(evidence, reason=reason))
                                continue
                            try:
                                shutil.rmtree(job)
                            except OSError as error:
                                entry.update(status="delete_failed", reason=str(error))
                                audit("delete_failed", sweep_id, **dict(evidence, reason=str(error)))
                            else:
                                entry["status"] = "deleted"
                                audit("deleted", sweep_id, **evidence)
                        else:
                            entry["status"] = "eligible"
            except BlockingIOError:
                entry["reason"] = "command still holds the scratch lock"
            except (OSError, ValueError, KeyError, TypeError, RuntimeError,
                    review.sqlite3.Error, subprocess.SubprocessError) as exc:
                entry["reason"] = str(exc)
    sweep_builds(cfg, apply, sweep_id, result["entries"])
    return result


def allocate(cfg, options, command_scope):
    thread = options.thread or os.environ.get("T3CODE_THREAD_ID")
    if not thread:
        raise ValueError("Run from T3 or pass --thread with the current T3 thread ID")
    if os.environ.get("T3CODE_THREAD_ID", thread) != thread:
        raise ValueError("--thread must match the current T3 thread")
    checkout = thread_checkout(review.load_t3(DB), thread)
    cwd = Path.cwd().resolve()
    if cwd != checkout and checkout not in cwd.parents:
        raise ValueError("Current directory is outside the T3 thread's checkout")
    name = options.pool or next(iter(cfg["pools"]), None)
    if name not in cfg["pools"]:
        raise ValueError("Pool is not configured")
    cmd = options.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        raise ValueError("Pass a foreground command after --")
    pool = ensure_directory(ROOT / name)
    job = pool / uuid.uuid4().hex
    job.mkdir(mode=0o700)
    data = job / "data"
    data.mkdir(mode=0o700)
    fd = command_scope.enter_context(lock(job, create=True))
    registration = {"job": job.name, "job_identity": identity(job),
                    "data_identity": identity(data), "thread": thread, "checkout": str(checkout),
                    "checkout_identity": identity(checkout), "finished_at": None}
    write_json(job / "owner.json", registration)
    return job, registration, cmd, fd


def run(options):
    with ExitStack() as command_scope:
        with config_lock(shared=True):
            cfg = settings()
            configure_storage(cfg)
            job, registration, cmd, fd = allocate(cfg, options, command_scope)
        data = job / "data"
        print(f"Disposable scratch: {data}", file=sys.stderr)
        env = dict(os.environ, AGENT_TMP_DIR=str(data), TMPDIR=str(data) + "/")
        result = subprocess.run(cmd, env=env, pass_fds=(fd,))
        registration["finished_at"] = time.time()
        write_json(job / "owner.json", registration)
        return result.returncode if result.returncode >= 0 else 128 - result.returncode


def pool_name(value):
    path = Path(value).expanduser()
    if path.parent != ROOT or not POOL_NAME.fullmatch(path.name):
        raise ValueError(f"Pool must be a direct child of {ROOT} with a lowercase name")
    return path.name


def configure_pool(cfg, value, add):
    name = pool_name(value)
    if add:
        if name in cfg["pools"]:
            return
        path = ensure_directory(ROOT / name)
        if any(path.iterdir()):
            raise ValueError("An existing pool must be empty before it can be registered")
        cfg["pools"].append(name)
    elif name in cfg["pools"]:
        cfg["pools"].remove(name)
    write_json(CONFIG, cfg)


def launchctl(*args, check=True):
    return subprocess.run(["/bin/launchctl", *args], text=True, capture_output=True,
                          timeout=30, check=check)


def domain():
    return f"gui/{os.getuid()}"


def loaded():
    result = launchctl("print", f"{domain()}/{LABEL}", check=False)
    if result.returncode == 0:
        return True
    if "Could not find service" in result.stderr:
        return False
    if "Could not find domain" in result.stderr:
        return False
    raise RuntimeError(result.stderr.strip() or "Could not read LaunchAgent status")


def definition(minutes):
    return {"Label": LABEL,
            "ProgramArguments": [*SERVICE_COMMAND, "_sweep"],
            "StartInterval": minutes * 60, "RunAtLoad": True}


def installed_definition():
    if not PLIST.exists() and not PLIST.is_symlink():
        return None
    if PLIST.is_symlink() or not PLIST.is_file() or PLIST.stat().st_uid != os.getuid():
        raise ValueError("Refusing to touch an unowned or symlinked LaunchAgent")
    try:
        old = plistlib.loads(PLIST.read_bytes())
        interval = old["StartInterval"]
        if (type(interval) is not int or interval % 60 or not 60 <= interval <= MAX_MINUTES * 60
                or old != definition(interval // 60)):
            raise ValueError("definition does not match this checkout")
    except (ValueError, KeyError, TypeError) as error:
        raise ValueError(f"Refusing to replace or remove {PLIST}: {error}") from error
    return old


def configure_service(minutes=None):
    old = installed_definition()
    running = loaded()
    if running and old is None:
        raise RuntimeError("A service with this label is loaded without a matching plist")
    new = definition(minutes) if minutes is not None else None
    if new == old and running == (new is not None):
        return
    if running:
        launchctl("bootout", f"{domain()}/{LABEL}")
    try:
        if new is None:
            PLIST.unlink()
        else:
            ensure_directory(PLIST.parent)
            if new != old:
                write_file(PLIST, plistlib.dumps(new))
            launchctl("bootstrap", domain(), str(PLIST))
    except (OSError, ValueError, subprocess.SubprocessError):
        if old is None:
            if PLIST.exists():
                PLIST.unlink()
        else:
            write_file(PLIST, plistlib.dumps(old))
            if running:
                launchctl("bootstrap", domain(), str(PLIST))
        raise


def config_details(cfg):
    return {"config": str(CONFIG), "deletion_boundary": str(ROOT),
            "pools": [str(ROOT / name) for name in cfg["pools"]],
            "interval_minutes": cfg["interval_minutes"],
            "settlement_grace_minutes": cfg["settlement_grace_seconds"] // 60,
            "launch_agent": str(PLIST), "latest_sweep_file": str(REPORT),
            "audit_directory": str(AUDIT_DIR), "log_retention_days": cfg["log_retention_days"],
            "build_artifacts_root": cfg.get("build_artifacts_root")}


def status():
    result = {"loaded": loaded(), "launch_agent": str(PLIST), "latest_sweep_file": str(REPORT),
              "audit_directory": str(AUDIT_DIR)}
    try:
        report = read_local_json(REPORT)
    except FileNotFoundError:
        report = None
    result["last_sweep"] = report
    return result


def scheduled_sweep():
    sweep_id = uuid.uuid4().hex
    failed = False
    try:
        cfg = settings(missing_ok=False)
        configure_storage(cfg)
        audit("sweep_started", sweep_id)
        expire_audit(cfg["log_retention_days"])
        result = sweep(cfg, apply=True, sweep_id=sweep_id)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError,
            review.sqlite3.Error, subprocess.SubprocessError) as error:
        result = {"mode": "automatic", "generated_at": datetime.now().astimezone().isoformat(),
                  "error": str(error), "entries": []}
        failed = True
    ensure_directory(REPORT.parent)
    result["sweep_id"] = sweep_id
    write_json(REPORT, result)
    audit("sweep_finished", sweep_id, report=result)
    return int(failed)


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(prog="ai-butler", description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    listing = commands.add_parser("list", help="List managed paths and configuration")
    listing.add_argument("--json", action="store_true")
    commands.add_parser("add", help="Register a new or empty pool").add_argument("path")
    commands.add_parser("remove", help="Unregister a pool without deleting it").add_argument("path")
    install = commands.add_parser("install", help="Install or load the user LaunchAgent")
    install.add_argument("--hooks", action="store_true", help="Also configure agent startup hooks")
    install.add_argument("--artifact-root", type=Path,
                         help="Local artifact storage for --hooks")
    commands.add_parser("uninstall", help="Unload and remove the LaunchAgent")
    commands.add_parser("setInterval", help="Set sweep interval in minutes (0 resets to 60)").add_argument("minutes", type=int)
    commands.add_parser("setSettlementGracePeriod", help="Set settlement grace in minutes").add_argument("minutes", type=int)
    commands.add_parser("setLogRetention", help="Set audit retention in days (default 7)").add_argument("days", type=int)
    commands.add_parser("preview", help="Show current eligibility; remove nothing")
    commands.add_parser("status", help="Show LaunchAgent and last sweep status")
    hook = commands.add_parser("artifact-hook", help="Allocate workspace and run output paths")
    hook.add_argument("provider", choices=("codex", "claude", "cursor", "other"))
    hook.add_argument("--cwd")
    hook.add_argument("--session")
    foreground = commands.add_parser("run", help="Run one foreground command with disposable temp")
    foreground.add_argument("--thread")
    foreground.add_argument("--pool")
    foreground.add_argument("command", nargs=argparse.REMAINDER)
    try:
        if sys.argv[1:] == ["_sweep"]:
            with config_lock():
                # shortcut: local T3 projections cannot lock turn startup; scratch is single-use.
                return scheduled_sweep()
        options = parser.parse_args()
        action = options.action
        if action == "artifact-hook":
            return artifact_hook(options)
        if action == "run":
            return run(options)
        if action == "status":
            configure_storage(settings())
            print(json.dumps(status(), indent=2))
            return 0
        if action in ("list", "preview"):
            cfg = settings()
            configure_storage(cfg)
            result = config_details(cfg) if action == "list" else sweep(cfg, apply=False)
            if action == "list" and not options.json:
                print(f"Config: {CONFIG}\nSweep: {cfg['interval_minutes']} min; "
                      f"settlement grace: {cfg['settlement_grace_seconds'] // 60} min")
                print(f"Audit logs: {AUDIT_DIR} ({cfg['log_retention_days']} days)")
                if cfg.get("build_artifacts_root"):
                    print(f"Build artifacts: {cfg['build_artifacts_root']}")
                print("\n".join(result["pools"]) or "(no pools configured)")
            else:
                print(json.dumps(result, indent=2))
            return 0
        with config_lock():
            if action == "uninstall":
                configure_service()
                return 0
            cfg = settings()
            configure_storage(cfg)
            if action == "install":
                if options.artifact_root is not None and not options.hooks:
                    raise ValueError("--artifact-root requires --hooks")
                ensure_directory(ROOT)
                if options.hooks:
                    current = cfg.get("build_artifacts_root")
                    selected = options.artifact_root or Path(current or DATA / "Artifacts")
                    selected = str(selected.expanduser())
                    if current and current != selected:
                        raise ValueError("Stop the service and edit build_artifacts_root to change storage")
                    cfg["build_artifacts_root"] = selected
                    ensure_directory(build_workspaces(cfg))
                    changes = hook_updates()
                    write_json(CONFIG, cfg)
                    configure_service(cfg["interval_minutes"])
                    for path, data in changes:
                        write_json(path, data)
                    print("Startup hooks installed. Trust the new Codex hook in /hooks if prompted.")
                else:
                    if not CONFIG.exists():
                        write_json(CONFIG, cfg)
                    configure_service(cfg["interval_minutes"])
            elif action in ("add", "remove"):
                configure_pool(cfg, options.path, action == "add")
            elif action == "setLogRetention":
                if not 1 <= options.days <= 36500:
                    raise ValueError("Days must be between 1 and 36500")
                cfg["log_retention_days"] = options.days
                write_json(CONFIG, cfg)
            else:
                minutes = options.minutes
                if action == "setInterval" and minutes == 0:
                    minutes = DEFAULT_INTERVAL
                if not 1 <= minutes <= MAX_MINUTES:
                    raise ValueError(f"Minutes must be between 1 and {MAX_MINUTES}")
                if action == "setInterval":
                    previous = cfg.copy()
                    cfg["interval_minutes"] = minutes
                    installed = installed_definition() is not None
                    write_json(CONFIG, cfg)
                    if installed:
                        try:
                            configure_service(minutes)
                        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
                            write_json(CONFIG, previous)
                            raise
                else:
                    cfg["settlement_grace_seconds"] = minutes * 60
                    write_json(CONFIG, cfg)
        return 0
    except subprocess.CalledProcessError as exc:
        print(f"ai-butler: {exc.stderr.strip() if exc.stderr else exc}", file=sys.stderr)
        return 1
    except (OSError, ValueError, KeyError, TypeError, RuntimeError,
            review.sqlite3.Error, subprocess.SubprocessError) as exc:
        print(f"ai-butler: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
